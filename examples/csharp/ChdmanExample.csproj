<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Example app using the LibChdman binding (bindings/csharp/LibChdman).
      dotnet run -p:ChdmanLibDir=<dir containing chdman.dll or libchdman.dylib>
    An app using the NuGet package instead needs only
      <PackageReference Include="LibChdman" Version="1.0.0" />
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../bindings/csharp/LibChdman/LibChdman.csproj" />
  </ItemGroup>

  <Import Project="../../bindings/csharp/ChdmanNativeCopy.targets" />

</Project>
