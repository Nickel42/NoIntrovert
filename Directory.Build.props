<Project>
  <!--
    Where lib-chd-kit lives and which native build of it to ship.

    LibChdKitRoot defaults to native/lib-chd-kit in this repository (pass
    -p:LibChdKitRoot=... to use another checkout). The native library is taken from
    $(LibChdKitRoot)/artifacts/native/<dir>, where <dir> follows the
    RuntimeIdentifier being built or published:

      win-x64    -> win-x64/chdkit.dll
      win-arm64  -> win-arm64/chdkit.dll
      osx-*      -> osx/libchdkit.dylib   (universal arm64 + x86_64)
      linux-x64  -> linux-x64/libchdkit.so

    With no RuntimeIdentifier, the machine doing the build decides.
    Pass -p:ChdmanLibDir=<dir> to point at any other build.
  -->
  <PropertyGroup>
    <LibChdKitRoot Condition="'$(LibChdKitRoot)' == ''">$(MSBuildThisFileDirectory)native/lib-chd-kit</LibChdKitRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ChdmanNativeDir)' == ''">
    <ChdmanNativeDir Condition="'$(RuntimeIdentifier)' == 'win-arm64'">win-arm64</ChdmanNativeDir>
    <ChdmanNativeDir Condition="'$(RuntimeIdentifier)' == 'win-x64'">win-x64</ChdmanNativeDir>
    <ChdmanNativeDir Condition="$(RuntimeIdentifier.StartsWith('osx'))">osx</ChdmanNativeDir>
    <ChdmanNativeDir Condition="'$(RuntimeIdentifier)' == 'linux-x64'">linux-x64</ChdmanNativeDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ChdmanNativeDir)' == ''">
    <ChdmanNativeDir Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</ChdmanNativeDir>
    <ChdmanNativeDir Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</ChdmanNativeDir>
    <ChdmanNativeDir Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">win-arm64</ChdmanNativeDir>
    <ChdmanNativeDir Condition="'$(ChdmanNativeDir)' == ''">win-x64</ChdmanNativeDir>
  </PropertyGroup>

  <PropertyGroup>
    <ChdmanLibDir Condition="'$(ChdmanLibDir)' == ''">$(LibChdKitRoot)/artifacts/native/$(ChdmanNativeDir)</ChdmanLibDir>
  </PropertyGroup>

  <!--
    lib-7z-zip-kit (7z and zip archives through 7-Zip's engine, plus a managed
    reader), its own repository, checked out as a git submodule in
    native/lib-7z-zip-kit. Its scripts (fetch-sources.sh, then build-win.cmd,
    build-mac.sh or build-linux.sh) put 7-Zip's library and sevenzipkit in
    $(Lib7zZipKitRoot)artifacts/native/<dir>, and its
    build/lib-7z-zip-kit.Native.targets (imported by NoIntrovert.csproj) copies
    them next to the app. Pass -p:Lib7zZipKitRoot=... (ending in a slash) to use
    another checkout, or -p:SevenZipKitLibDir=<dir> to use another build.
  -->
  <PropertyGroup>
    <Lib7zZipKitRoot Condition="'$(Lib7zZipKitRoot)' == ''">$(MSBuildThisFileDirectory)native/lib-7z-zip-kit/</Lib7zZipKitRoot>
  </PropertyGroup>

  <!--
    lib-wii-u-kit (Wii U titles to Cemu's .wua), its own repository, checked
    out as a git submodule in native/lib-wii-u-kit. It is pure managed code, so
    there is nothing to build first. Pass -p:LibWiiUKitRoot=... (ending in a
    slash) to use another checkout.
  -->
  <PropertyGroup>
    <LibWiiUKitRoot Condition="'$(LibWiiUKitRoot)' == ''">$(MSBuildThisFileDirectory)native/lib-wii-u-kit/</LibWiiUKitRoot>
  </PropertyGroup>

  <!--
    lib-3ds-kit (Nintendo 3DS: decrypting, CIA to CCI, Azahar's .zcci), its own
    repository, checked out as a git submodule in native/lib-3ds-kit. It is pure
    managed code, so there is nothing to build first. Pass -p:LibThreeDsKitRoot=...
    (ending in a slash) to use another checkout.
  -->
  <PropertyGroup>
    <LibThreeDsKitRoot Condition="'$(LibThreeDsKitRoot)' == ''">$(MSBuildThisFileDirectory)native/lib-3ds-kit/</LibThreeDsKitRoot>
  </PropertyGroup>

  <!--
    lib-nx-kit (Nintendo Switch: NSP, NSZ, XCI and XCZ), its own repository, checked
    out as a git submodule in native/lib-nx-kit. It is pure managed code, so there is
    nothing to build first. Pass -p:LibNxKitRoot=... (ending in a slash) to use another checkout.
  -->
  <PropertyGroup>
    <LibNxKitRoot Condition="'$(LibNxKitRoot)' == ''">$(MSBuildThisFileDirectory)native/lib-nx-kit/</LibNxKitRoot>
  </PropertyGroup>

  <!--
    lib-wii-gamecube-kit (Dolphin's GameCube/Wii disc code), its own
    repository, checked out as a git submodule in native/lib-wii-gamecube-kit
    (run "git submodule update" with init after cloning). Its build scripts put the native library
    in $(LibWiiGameCubeKitRoot)/artifacts/native/<dir>, with the same <dir> names as above:
      win-*      -> lib-wii-gamecube-kit.dll
      osx        -> lib-wii-gamecube-kit.dylib (universal)
      linux-x64  -> lib-wii-gamecube-kit.so
    Its build/lib-wii-gamecube-kit.Native.targets (imported by NoIntrovert.csproj) copies
    it next to the app. Pass -p:LibWiiGameCubeKitRoot=... to use another checkout, or
    -p:LibWiiGameCubeKitLibDir=<dir> to use another build.
  -->
  <PropertyGroup>
    <LibWiiGameCubeKitRoot Condition="'$(LibWiiGameCubeKitRoot)' == ''">$(MSBuildThisFileDirectory)native/lib-wii-gamecube-kit</LibWiiGameCubeKitRoot>
    <LibWiiGameCubeKitNativeDir Condition="'$(LibWiiGameCubeKitNativeDir)' == ''">$(ChdmanNativeDir)</LibWiiGameCubeKitNativeDir>
  </PropertyGroup>
</Project>
