<Project>
  <!--
    Where libchdman lives and which native build of it to ship.

    LibChdmanRoot defaults to native/libchdman in this repository (pass
    -p:LibChdmanRoot=... to use another checkout). The native library is taken from
    $(LibChdmanRoot)/artifacts/native/<dir>, where <dir> follows the
    RuntimeIdentifier being built or published:

      win-x64    -> win-x64/chdman.dll
      win-arm64  -> win-arm64/chdman.dll
      osx-*      -> osx/libchdman.dylib   (universal arm64 + x86_64)
      linux-x64  -> linux-x64/libchdman.so

    With no RuntimeIdentifier, the machine doing the build decides.
    Pass -p:ChdmanLibDir=<dir> to point at any other build.
  -->
  <PropertyGroup>
    <LibChdmanRoot Condition="'$(LibChdmanRoot)' == ''">$(MSBuildThisFileDirectory)native/libchdman</LibChdmanRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ChdmanNativeDir)' == ''">
    <ChdmanNativeDir Condition="'$(RuntimeIdentifier)' == 'win-arm64'">win-arm64</ChdmanNativeDir>
    <ChdmanNativeDir Condition="'$(RuntimeIdentifier)' == 'win-x64'">win-x64</ChdmanNativeDir>
    <ChdmanNativeDir Condition="$(RuntimeIdentifier.StartsWith('osx'))">osx</ChdmanNativeDir>
    <ChdmanNativeDir Condition="'$(RuntimeIdentifier)' == 'linux-x64'">linux-x64</ChdmanNativeDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ChdmanNativeDir)' == ''">
    <ChdmanNativeDir Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</ChdmanNativeDir>
    <ChdmanNativeDir Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</ChdmanNativeDir>
    <ChdmanNativeDir Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">win-arm64</ChdmanNativeDir>
    <ChdmanNativeDir Condition="'$(ChdmanNativeDir)' == ''">win-x64</ChdmanNativeDir>
  </PropertyGroup>

  <PropertyGroup>
    <ChdmanLibDir Condition="'$(ChdmanLibDir)' == ''">$(LibChdmanRoot)/artifacts/native/$(ChdmanNativeDir)</ChdmanLibDir>
  </PropertyGroup>

  <!--
    The archive engine: 7-Zip's library and noi_archive (our C interface over
    bit7z), built by native/build-win.cmd, native/build-mac.sh or
    native/build-linux.sh into native/out/<dir>, using the same <dir> names as above:
      win-*      -> 7z.dll + noi_archive.dll
      osx        -> 7z.so + libnoi_archive.dylib (universal)
      linux-x64  -> 7z.so + libnoi_archive.so
    Pass -p:NoiArchiveLibDir=<dir> to use another build.
  -->
  <PropertyGroup>
    <NoiArchiveLibDir Condition="'$(NoiArchiveLibDir)' == ''">$(MSBuildThisFileDirectory)native/out/$(ChdmanNativeDir)</NoiArchiveLibDir>
  </PropertyGroup>

  <!--
    libdolphinrvz (Dolphin's GameCube/Wii disc code, native/libdolphinrvz),
    built into native/out/<dir> next to the archive engine:
      win-*      -> dolphinrvz.dll
      osx        -> libdolphinrvz.dylib (universal)
      linux-x64  -> libdolphinrvz.so
    Pass -p:DolphinRvzLibDir=<dir> to use another build.
  -->
  <PropertyGroup>
    <DolphinRvzRoot>$(MSBuildThisFileDirectory)native/libdolphinrvz</DolphinRvzRoot>
    <DolphinRvzLibDir Condition="'$(DolphinRvzLibDir)' == ''">$(MSBuildThisFileDirectory)native/out/$(ChdmanNativeDir)</DolphinRvzLibDir>
  </PropertyGroup>
</Project>
