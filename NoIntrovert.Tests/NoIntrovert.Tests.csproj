<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-checking test program (no test framework), in the style of
    LibChdman.Tests. Builds sample images in every input format from the
    discs in ..\..\test-roms, converts them through the app's code and
    libchdman, and checks the CHD data against the original.

    Run with: dotnet run -c Release, followed by the program's own options:
    quick (skip the full-disc round trips), roms DIR, upstream CHDMAN.EXE,
    each written with a leading double dash.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LibChdmanRoot Condition="'$(LibChdmanRoot)' == ''">$(MSBuildThisFileDirectory)..\..\libchdman</LibChdmanRoot>
    <ChdmanLibDir Condition="'$(ChdmanLibDir)' == ''">$(LibChdmanRoot)\artifacts\native\win-x64</ChdmanLibDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoIntrovert\NoIntrovert.csproj" />
  </ItemGroup>

  <Import Project="$(LibChdmanRoot)\bindings\csharp\ChdmanNativeCopy.targets" />
</Project>
