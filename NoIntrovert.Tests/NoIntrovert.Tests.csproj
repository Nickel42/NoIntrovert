<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-checking test program (no test framework), in the style of
    LibChdKit.Tests. Builds sample images in every input format from the
    discs in ..\..\test-roms, converts them through the app's code and
    lib-chd-kit, and checks the CHD data against the original.

    Run with: dotnet run -c Release, followed by the program's own options:
    quick (skip the full-disc round trips), roms DIR, upstream CHDMAN.EXE,
    each written with a leading double dash.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoIntrovert\NoIntrovert.csproj" />
    <!-- The layout tests open the real window without a screen (LayoutTests.cs) -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- lib-psvita-kit's synthetic package builder (made-up keys), for the PS Vita .pkg tests -->
    <Compile Include="$(LibPsVitaKitRoot)tests/lib-psvita-kit.Tests/PkgBuilder.cs" Link="Vita/PkgBuilder.cs" />
  </ItemGroup>

  <Import Project="$(LibChdKitRoot)/bindings/csharp/ChdmanNativeCopy.targets" />
</Project>
