<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Everything NoIntrovert does to files, without a window: formats, presets, the job queue, Verify & match,
    the Organize planner and runner, the libraries' bindings. The app (NoIntrovert) and the command line
    (noi, NoIntrovert.Cli) both run on it, so they do exactly the same thing.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NoIntrovert.Core</RootNamespace>
    <AssemblyName>NoIntrovert.Core</AssemblyName>
    <Version>0.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also used directly (IszDecoder's BZip2Stream); lib-7z-zip-kit brings the same version. -->
    <PackageReference Include="SharpCompress" Version="0.50.9" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.15" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(LibChdKitRoot)/bindings/csharp/LibChdKit/LibChdKit.csproj" />
    <ProjectReference Include="$(LibWiiGameCubeKitRoot)/bindings/csharp/LibWiiGameCubeKit/LibWiiGameCubeKit.csproj" />
    <ProjectReference Include="$(Lib7zZipKitRoot)src/lib-7z-zip-kit/lib-7z-zip-kit.csproj" />
    <ProjectReference Include="$(LibWiiUKitRoot)src/lib-wii-u-kit/lib-wii-u-kit.csproj" />
    <ProjectReference Include="$(LibThreeDsKitRoot)src/lib-3ds-kit/lib-3ds-kit.csproj" />
    <ProjectReference Include="$(LibNxKitRoot)src/lib-nx-kit/lib-nx-kit.csproj" />
    <ProjectReference Include="$(LibXisoKitRoot)src/lib-xiso-kit/lib-xiso-kit.csproj" />
    <ProjectReference Include="$(LibPs3KitRoot)src/lib-ps3-kit/lib-ps3-kit.csproj" />
    <ProjectReference Include="$(LibPsVitaKitRoot)src/lib-psvita-kit/lib-psvita-kit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoIntrovert" />
    <InternalsVisibleTo Include="noi" />
    <InternalsVisibleTo Include="NoIntrovert.Tests" />
  </ItemGroup>

  <!-- The target-format registry (one entry per system in docs/target-formats.md). -->
  <ItemGroup>
    <EmbeddedResource Include="Formats/TargetFormats.json" LogicalName="NoIntrovert.TargetFormats.json" />
    <!-- ES-DE's system folders as of its latest release (Esde, docs/requirements/cleanup-wizard.md). -->
    <EmbeddedResource Include="Esde/es_systems.json" LogicalName="NoIntrovert.es_systems.json" />
    <!-- The File section's hand-checked system facts and format paragraphs (Systems, docs/requirements/ui-redesign.md). -->
    <EmbeddedResource Include="Systems/SystemFacts.json" LogicalName="NoIntrovert.SystemFacts.json" />
    <EmbeddedResource Include="Systems/SystemFormats.json" LogicalName="NoIntrovert.SystemFormats.json" />
    <!-- Emulator data for "Works with" (Emulators; scripts/refresh-emulator-data.py writes emulators.json). -->
    <EmbeddedResource Include="Emulators/Data/emulators.json" LogicalName="NoIntrovert.Emulators.emulators.json" />
    <EmbeddedResource Include="Emulators/Data/emulator-facts.json" LogicalName="NoIntrovert.Emulators.emulator-facts.json" />
  </ItemGroup>
</Project>
