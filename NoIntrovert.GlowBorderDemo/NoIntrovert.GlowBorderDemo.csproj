<Project Sdk="Microsoft.NET.Sdk">
  <!-- A window showing GlowBorder on cards and buttons. Run with "light" for the light theme. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The app's own copy of the control, so the demo always shows the current version. -->
    <Compile Include="../NoIntrovert/Controls/GlowBorder.cs" Link="GlowBorder.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>
</Project>
