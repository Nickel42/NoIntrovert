<!--
  Dracula's background, its lighter shades for cards, purple buttons and the pink accent.
  A classic theme NoIntrovert ships: an Avalonia ResourceDictionary like NoIntrovert's own. Each ThemeXxx
  colour is one of the theme's roles; the app works out the rest from them.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:String x:Key="ThemeName">Dracula</x:String>
    <x:String x:Key="ThemeVariant">Dark</x:String>
    <x:String x:Key="ThemeAuthor">Zeno Rocha</x:String>
    <Color x:Key="ThemeBackground">#282A36</Color>
    <Color x:Key="ThemeSurface">#343746</Color>
    <Color x:Key="ThemeRaised">#3C3E4E</Color>
    <Color x:Key="ThemeHeader">#21222C</Color>
    <Color x:Key="ThemeBorder">#44475A</Color>
    <Color x:Key="ThemeControlBorder">#6272A4</Color>
    <Color x:Key="ThemeText">#F8F8F2</Color>
    <Color x:Key="ThemeSubtleText">#BFC3D9</Color>
    <Color x:Key="ThemeSectionText">#BD93F9</Color>
    <Color x:Key="ThemePrimary">#BD93F9</Color>
    <Color x:Key="ThemeAccent">#FF79C6</Color>
    <Color x:Key="ThemeDanger">#FF5555</Color>
    <Color x:Key="ThemeWarning">#FFB86C</Color>
    <Color x:Key="ThemeSuccess">#50FA7B</Color>

    <!-- Exact colours where the palette's own one wouldn't read as text. -->
    <SolidColorBrush x:Key="DangerText" Color="#FF7979" />
</ResourceDictionary>
