<!--
  Tokyo Night Light's grey-blue background, deep blue buttons and ink-coloured text.
  A classic theme NoIntrovert ships: an Avalonia ResourceDictionary like NoIntrovert's own. Each ThemeXxx
  colour is one of the theme's roles; the app works out the rest from them.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:String x:Key="ThemeName">Tokyo Night Light</x:String>
    <x:String x:Key="ThemeVariant">Light</x:String>
    <x:String x:Key="ThemeAuthor">enkia</x:String>
    <Color x:Key="ThemeBackground">#CBCCD1</Color>
    <Color x:Key="ThemeSurface">#D5D6DB</Color>
    <Color x:Key="ThemeRaised">#D0D1D6</Color>
    <Color x:Key="ThemeHeader">#D5D6DB</Color>
    <Color x:Key="ThemeBorder">#C1C2C7</Color>
    <Color x:Key="ThemeControlBorder">#9699A3</Color>
    <Color x:Key="ThemeText">#343B58</Color>
    <Color x:Key="ThemeSubtleText">#4C505E</Color>
    <Color x:Key="ThemeSectionText">#34548A</Color>
    <Color x:Key="ThemePrimary">#34548A</Color>
    <Color x:Key="ThemeAccent">#5A4A78</Color>
    <Color x:Key="ThemeDanger">#8C4351</Color>
    <Color x:Key="ThemeWarning">#8F5E15</Color>
    <Color x:Key="ThemeSuccess">#485E30</Color>

    <!-- Exact colours where the palette's own one wouldn't read as text. -->
    <SolidColorBrush x:Key="DangerText" Color="#7E3A47" />
</ResourceDictionary>
