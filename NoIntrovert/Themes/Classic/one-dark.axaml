<!--
  Atom's One Dark: the editor background, its darker sidebar, blue buttons and purple accent.
  A classic theme NoIntrovert ships: an Avalonia ResourceDictionary like NoIntrovert's own. Each ThemeXxx
  colour is one of the theme's roles; the app works out the rest from them.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:String x:Key="ThemeName">One Dark</x:String>
    <x:String x:Key="ThemeVariant">Dark</x:String>
    <x:String x:Key="ThemeAuthor">Atom</x:String>
    <Color x:Key="ThemeBackground">#282C34</Color>
    <Color x:Key="ThemeSurface">#2F343F</Color>
    <Color x:Key="ThemeRaised">#353B45</Color>
    <Color x:Key="ThemeHeader">#21252B</Color>
    <Color x:Key="ThemeBorder">#3E4451</Color>
    <Color x:Key="ThemeControlBorder">#545862</Color>
    <Color x:Key="ThemeText">#ABB2BF</Color>
    <Color x:Key="ThemeSubtleText">#9DA5B4</Color>
    <Color x:Key="ThemeSectionText">#61AFEF</Color>
    <Color x:Key="ThemePrimary">#61AFEF</Color>
    <Color x:Key="ThemeAccent">#C678DD</Color>
    <Color x:Key="ThemeDanger">#E06C75</Color>
    <Color x:Key="ThemeWarning">#D19A66</Color>
    <Color x:Key="ThemeSuccess">#98C379</Color>

    <!-- Exact colours where the palette's own one wouldn't read as text. -->
    <SolidColorBrush x:Key="DangerText" Color="#E48188" />
</ResourceDictionary>
