<!--
  Polar Night backgrounds, Snow Storm text and Frost blue, with Aurora for states.
  A classic theme NoIntrovert ships: an Avalonia ResourceDictionary like NoIntrovert's own. Each ThemeXxx
  colour is one of the theme's roles; the app works out the rest from them.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:String x:Key="ThemeName">Nord</x:String>
    <x:String x:Key="ThemeVariant">Dark</x:String>
    <x:String x:Key="ThemeAuthor">Arctic Ice Studio</x:String>
    <Color x:Key="ThemeBackground">#2E3440</Color>
    <Color x:Key="ThemeSurface">#3B4252</Color>
    <Color x:Key="ThemeRaised">#434C5E</Color>
    <Color x:Key="ThemeHeader">#292E39</Color>
    <Color x:Key="ThemeBorder">#434C5E</Color>
    <Color x:Key="ThemeControlBorder">#616E88</Color>
    <Color x:Key="ThemeText">#ECEFF4</Color>
    <Color x:Key="ThemeSubtleText">#C0C8D6</Color>
    <Color x:Key="ThemeSectionText">#88C0D0</Color>
    <Color x:Key="ThemePrimary">#88C0D0</Color>
    <Color x:Key="ThemeAccent">#EBCB8B</Color>
    <Color x:Key="ThemeDanger">#BF616A</Color>
    <Color x:Key="ThemeWarning">#D08770</Color>
    <Color x:Key="ThemeSuccess">#A3BE8C</Color>

    <!-- Exact colours where the palette's own one wouldn't read as text. -->
    <SolidColorBrush x:Key="DangerText" Color="#D9A2A7" />
</ResourceDictionary>
