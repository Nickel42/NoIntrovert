<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>NoIntrovert</AssemblyTitle>
    <Product>NoIntrovert - libchdman test bench</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(LibChdmanRoot)/bindings/csharp/LibChdman/LibChdman.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoIntrovert.Tests" />
  </ItemGroup>

  <Import Project="$(LibChdmanRoot)/bindings/csharp/ChdmanNativeCopy.targets" />

  <!-- A plain build may run without libchdman (with a warning); a publish for a platform must include it. -->
  <Target Name="WarnMissingChdmanNative" BeforeTargets="Build"
          Condition="!Exists('$(ChdmanLibDir)/chdman.dll') And !Exists('$(ChdmanLibDir)/libchdman.dylib')">
    <Warning Text="No libchdman native library in $(ChdmanLibDir); the app builds but can't run CHD operations. Build libchdman for $(ChdmanNativeDir) first." />
  </Target>
  <Target Name="RequireChdmanNativeForPublish" BeforeTargets="PrepareForPublish"
          Condition="'$(RuntimeIdentifier)' != '' And !Exists('$(ChdmanLibDir)/chdman.dll') And !Exists('$(ChdmanLibDir)/libchdman.dylib')">
    <Error Text="Can't publish for $(RuntimeIdentifier): no libchdman native library in $(ChdmanLibDir)." />
  </Target>

  <!-- SkiaSharp and HarfBuzz ship ~100 MB of native .pdb files; release downloads don't need them. -->
  <Target Name="DropPackageSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' Or '%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>
</Project>
