<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The .exe's own icon; Windows only (macOS uses packaging/macos/NoIntrovert.icns). -->
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">Assets/nointrovert.ico</ApplicationIcon>
    <AssemblyTitle>NoIntrovert</AssemblyTitle>
    <Product>NoIntrovert - libchdman and libdolphinrvz test bench</Product>
    <!-- Release builds get the version from the git tag (release.yml passes -p:Version). -->
    <Version>0.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(LibChdmanRoot)/bindings/csharp/LibChdman/LibChdman.csproj" />
    <ProjectReference Include="$(DolphinRvzRoot)/bindings/csharp/LibDolphinRvz/LibDolphinRvz.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoIntrovert.Tests" />
  </ItemGroup>

  <!-- The target-format registry (one entry per system in docs/target-formats.md). -->
  <ItemGroup>
    <EmbeddedResource Include="Core/Formats/TargetFormats.json" LogicalName="NoIntrovert.TargetFormats.json" />
    <!-- ES-DE's system folders as of its latest release (Core/Esde, docs/requirements/cleanup-wizard.md). -->
    <EmbeddedResource Include="Core/Esde/es_systems.json" LogicalName="NoIntrovert.es_systems.json" />
  </ItemGroup>

  <Import Project="$(LibChdmanRoot)/bindings/csharp/ChdmanNativeCopy.targets" />

  <!--
    The archive engine's native libraries (see Directory.Build.props). They stay
    next to the executable even in a single-file publish: bit7z loads 7-Zip's
    library by its path, which must be a real file beside the app.
  -->
  <ItemGroup>
    <None Include="$(NoiArchiveLibDir)/7z.dll" Condition="Exists('$(NoiArchiveLibDir)/7z.dll')" Link="7z.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
    <None Include="$(NoiArchiveLibDir)/noi_archive.dll" Condition="Exists('$(NoiArchiveLibDir)/noi_archive.dll')" Link="noi_archive.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
    <None Include="$(NoiArchiveLibDir)/7z.so" Condition="Exists('$(NoiArchiveLibDir)/7z.so')" Link="7z.so"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
    <None Include="$(NoiArchiveLibDir)/libnoi_archive.dylib" Condition="Exists('$(NoiArchiveLibDir)/libnoi_archive.dylib')" Link="libnoi_archive.dylib"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
    <None Include="$(NoiArchiveLibDir)/libnoi_archive.so" Condition="Exists('$(NoiArchiveLibDir)/libnoi_archive.so')" Link="libnoi_archive.so"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
  </ItemGroup>

  <!-- libdolphinrvz's native library, beside the executable like the archive engine. -->
  <ItemGroup>
    <None Include="$(DolphinRvzLibDir)/dolphinrvz.dll" Condition="Exists('$(DolphinRvzLibDir)/dolphinrvz.dll')" Link="dolphinrvz.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
    <None Include="$(DolphinRvzLibDir)/libdolphinrvz.dylib" Condition="Exists('$(DolphinRvzLibDir)/libdolphinrvz.dylib')" Link="libdolphinrvz.dylib"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
    <None Include="$(DolphinRvzLibDir)/libdolphinrvz.so" Condition="Exists('$(DolphinRvzLibDir)/libdolphinrvz.so')" Link="libdolphinrvz.so"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
  </ItemGroup>

  <Target Name="WarnMissingDolphinRvzNative" BeforeTargets="Build"
          Condition="!Exists('$(DolphinRvzLibDir)/dolphinrvz.dll') And !Exists('$(DolphinRvzLibDir)/libdolphinrvz.dylib') And !Exists('$(DolphinRvzLibDir)/libdolphinrvz.so')">
    <Warning Text="No libdolphinrvz in $(DolphinRvzLibDir); GameCube/Wii conversion won't work. Build it with native/libdolphinrvz/scripts/build-win.cmd, build-mac.sh or build-linux.sh." />
  </Target>
  <Target Name="RequireDolphinRvzNativeForPublish" BeforeTargets="PrepareForPublish"
          Condition="'$(RuntimeIdentifier)' != '' And !Exists('$(DolphinRvzLibDir)/dolphinrvz.dll') And !Exists('$(DolphinRvzLibDir)/libdolphinrvz.dylib') And !Exists('$(DolphinRvzLibDir)/libdolphinrvz.so')">
    <Error Text="Can't publish for $(RuntimeIdentifier): libdolphinrvz is missing from $(DolphinRvzLibDir)." />
  </Target>

  <!--
    libchdman's ChdmanNativeCopy.targets copies chdman.dll / libchdman.dylib;
    the Linux build, libchdman.so, is copied here.
  -->
  <ItemGroup>
    <None Include="$(ChdmanLibDir)/libchdman.so" Condition="Exists('$(ChdmanLibDir)/libchdman.so')" Link="libchdman.so"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="WarnMissingArchiveNative" BeforeTargets="Build"
          Condition="!Exists('$(NoiArchiveLibDir)/noi_archive.dll') And !Exists('$(NoiArchiveLibDir)/libnoi_archive.dylib') And !Exists('$(NoiArchiveLibDir)/libnoi_archive.so')">
    <Warning Text="No archive engine in $(NoiArchiveLibDir); the Archive tab won't work. Build it with native/build-win.cmd, native/build-mac.sh or native/build-linux.sh." />
  </Target>
  <Target Name="RequireArchiveNativeForPublish" BeforeTargets="PrepareForPublish"
          Condition="'$(RuntimeIdentifier)' != '' And !(Exists('$(NoiArchiveLibDir)/noi_archive.dll') And Exists('$(NoiArchiveLibDir)/7z.dll')) And !(Exists('$(NoiArchiveLibDir)/libnoi_archive.dylib') And Exists('$(NoiArchiveLibDir)/7z.so')) And !(Exists('$(NoiArchiveLibDir)/libnoi_archive.so') And Exists('$(NoiArchiveLibDir)/7z.so'))">
    <Error Text="Can't publish for $(RuntimeIdentifier): the archive engine (7-Zip library + noi_archive) is missing from $(NoiArchiveLibDir)." />
  </Target>

  <!-- A plain build may run without libchdman (with a warning); a publish for a platform must include it. -->
  <Target Name="WarnMissingChdmanNative" BeforeTargets="Build"
          Condition="!Exists('$(ChdmanLibDir)/chdman.dll') And !Exists('$(ChdmanLibDir)/libchdman.dylib') And !Exists('$(ChdmanLibDir)/libchdman.so')">
    <Warning Text="No libchdman native library in $(ChdmanLibDir); the app builds but can't run CHD operations. Build libchdman for $(ChdmanNativeDir) first." />
  </Target>
  <Target Name="RequireChdmanNativeForPublish" BeforeTargets="PrepareForPublish"
          Condition="'$(RuntimeIdentifier)' != '' And !Exists('$(ChdmanLibDir)/chdman.dll') And !Exists('$(ChdmanLibDir)/libchdman.dylib') And !Exists('$(ChdmanLibDir)/libchdman.so')">
    <Error Text="Can't publish for $(RuntimeIdentifier): no libchdman native library in $(ChdmanLibDir)." />
  </Target>

  <!-- SkiaSharp and HarfBuzz ship ~100 MB of native .pdb files; release downloads don't need them. -->
  <Target Name="DropPackageSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' Or '%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>
</Project>
