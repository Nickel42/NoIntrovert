<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The .exe's own icon; Windows only (macOS uses packaging/macos/NoIntrovert.icns). -->
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">Assets/nointrovert.ico</ApplicationIcon>
    <AssemblyTitle>NoIntrovert</AssemblyTitle>
    <Product>NoIntrovert - lib-chd-kit, lib-wii-gamecube-kit and lib-7z-zip-kit test bench</Product>
    <!-- Release builds get the version from the git tag (release.yml passes -p:Version). -->
    <Version>0.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    The built-in themes (Core/Themes): Avalonia ResourceDictionaries, read as theme files like the ones in
    the themes folder, so they're embedded as they are rather than compiled.
  -->
  <ItemGroup>
    <AvaloniaXaml Remove="Themes\*.axaml" />
    <EmbeddedResource Include="Themes\*.axaml" LogicalName="NoIntrovert.Themes.%(Filename).axaml" />
    <!-- The classic themes (Solarized, Dracula, Nord…): NoIntrovert's own theme files of those well-known palettes. -->
    <AvaloniaXaml Remove="Themes\Classic\*.axaml" />
    <EmbeddedResource Include="Themes\Classic\*.axaml" LogicalName="NoIntrovert.Themes.Classic.%(Filename).axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <!-- The look: SukiUI's controls in the design's colours (App.axaml). 7.x is the line for Avalonia 12. -->
    <PackageReference Include="SukiUI" Version="7.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything the app does to files, shared with the command line (noi). -->
    <ProjectReference Include="../NoIntrovert.Core/NoIntrovert.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoIntrovert.Tests" />
  </ItemGroup>

  <!-- chdkit, 7-Zip's engine and lib-wii-gamecube-kit beside the executable, as for noi. -->
  <Import Project="../build/NativeLibraries.targets" />
</Project>
