<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             xmlns:local="using:NoIntrovert.Views"
             xmlns:c="using:NoIntrovert.Controls"
             x:Class="NoIntrovert.Views.WorksWithList"
             x:DataType="vm:WorksWithViewModel">
    <!--
        "Works with this preset" (docs/requirements/ui-redesign.md, Preset
        section): every RetroArch core for the system, then the most common
        standalone emulators. Two columns per group; each entry is a 14 px
        round ✓/✕/? icon and the name; a ✕ entry also says why in small text
        under its name. A row is as tall as its taller entry (ColumnsPanel),
        so the other rows stay compact. Each entry is a plain button: a click,
        or Enter with the keyboard, shows the detail (also its tooltip), and a
        screen reader hears the name and whether it works.
    -->
    <UserControl.Styles>
        <Style Selector="Button.entry">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <!-- Beside a ✕ entry with its reason under it, the other entry keeps to the top of the row -->
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Frame" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.entry:focus-visible /template/ Border#PART_Frame">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <DataTemplate x:Key="EntryTemplate" x:DataType="vm:WorksWithItem">
            <Button Classes="entry" ToolTip.Tip="{Binding Detail}">
                <AutomationProperties.Name>
                    <MultiBinding StringFormat="{}{0}: {1}">
                        <Binding Path="Name" />
                        <Binding Path="State" Converter="{x:Static local:WorksWithConverters.StateText}" />
                    </MultiBinding>
                </AutomationProperties.Name>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" MaxWidth="320" />
                    </Flyout>
                </Button.Flyout>
            <Grid ColumnDefinitions="14,*" ColumnSpacing="7" Margin="2,3,8,3" Background="Transparent">
                <!-- The icon stays beside the name's line when a reason follows under it -->
                <Ellipse Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0"
                         Fill="{Binding State, Converter={x:Static local:WorksWithConverters.Fill}}" />
                <Path Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" RenderTransform="scale(0.68)"
                      Data="{Binding State, Converter={x:Static local:WorksWithConverters.Glyph}}"
                      Stroke="{Binding State, Converter={x:Static local:WorksWithConverters.GlyphBrush}}"
                      StrokeThickness="2.6" StrokeLineCap="Round" StrokeJoin="Round" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Opacity="{Binding State, Converter={x:Static local:WorksWithConverters.NameOpacity}}" />
                    <!-- Why it doesn't work: "No CHD support" -->
                    <TextBlock Classes="reason" Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource SubtleText}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding State, Converter={x:Static local:WorksWithConverters.ShowsReason}}" />
                </StackPanel>
            </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="2">
        <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="WORKS WITH THIS PRESET" Classes="head" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding PlayCount}" Classes="hint" FontSize="12" Margin="8,0,0,0"
                       HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding PlayCount}" />
        </Grid>
        <TextBlock Classes="hint" Text="No emulator data for this system." IsVisible="{Binding !HasAny}" />

        <TextBlock Text="RETROARCH CORES" Classes="group" Margin="0,2,0,2" IsVisible="{Binding HasCores}" />
        <ItemsControl ItemsSource="{Binding Cores}" ItemTemplate="{StaticResource EntryTemplate}" IsVisible="{Binding HasCores}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <c:ColumnsPanel Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBlock Text="STANDALONE" Classes="group" Margin="0,8,0,2" IsVisible="{Binding HasStandalone}" />
        <ItemsControl ItemsSource="{Binding Standalone}" ItemTemplate="{StaticResource EntryTemplate}" IsVisible="{Binding HasStandalone}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <c:ColumnsPanel Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <StackPanel Spacing="2" Margin="0,6,0,0">
            <TextBlock Classes="hint" FontSize="11" Text="{Binding Footer}" TextWrapping="Wrap"
                       ToolTip.Tip="{Binding Source}" />
            <HyperlinkButton Content="Learn more" NavigateUri="{Binding LearnMoreUri}" HorizontalAlignment="Left"
                             Padding="0" MinHeight="0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SectionText}"
                             ToolTip.Tip="RetroArch core documentation at docs.libretro.com" />
        </StackPanel>
    </StackPanel>
</UserControl>
