<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             x:Class="NoIntrovert.Views.CleanupView"
             xmlns:v="using:NoIntrovert.Views"
             x:DataType="vm:CleanupViewModel"
             v:Responsive.Below="narrow:1000">
    <UserControl.Styles>
        <Style Selector="ScrollViewer.sidepanel"><Setter Property="Width" Value="340" /></Style>
        <Style Selector="v|CleanupView.narrow ScrollViewer.sidepanel"><Setter Property="Width" Value="280" /></Style>
    </UserControl.Styles>
    <!--
        Organize (the Cleanup wizard, M7): the files in the list, each row's CHANGES column the dry run;
        a box per kind of step turns that kind on or off. Past runs can be undone, or their trash emptied.
    -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,10,0,0">
        <v:JobListPanel />

        <ScrollViewer Grid.Column="1" Classes="sidepanel" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <Border Classes="card">
                    <v:SelectedFilePanel DataContext="{Binding SelectedFile}" />
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="THE PLAN" Classes="section" />
                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                   Text="Only files Verify &amp; match recognised are renamed and moved; Optimize checks them first. Nothing changes until you click Organize." />
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding PlanSummary}"
                                   IsVisible="{Binding PlanSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPlanning}">
                            <ProgressBar IsIndeterminate="True" Width="60" Height="6" VerticalAlignment="Center" />
                            <TextBlock Text="Making the plan…" Classes="hint" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- One box per kind of step, with its count: ticks or unticks them all, half-ticked when only some are -->
                        <ItemsControl x:Name="KindToggles" ItemsSource="{Binding Kinds}" IsVisible="{Binding HasRunnableSteps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CleanupKindToggle">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" Command="{Binding ToggleCommand}" Content="{Binding Label}"
                                              ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding AccessibleName}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="BusyStatus" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                            <ProgressBar IsIndeterminate="True" Width="60" Height="6" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BusyText}" Classes="hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <v:OrganizeOptionsPanel DataContext="{Binding Options}" />
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="PAST RUNS" Classes="section" />
                        <TextBlock Text="No runs yet." Classes="hint" IsVisible="{Binding !HasRuns}" />
                        <ItemsControl ItemsSource="{Binding Runs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CleanupRunRow">
                                    <StackPanel Spacing="4" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Classes="tool" Content="Undo" IsVisible="{Binding CanUndo}"
                                                    ToolTip.Tip="Put back everything this run changed. You're asked first."
                                                    Command="{Binding $parent[UserControl].((vm:CleanupViewModel)DataContext).UndoCommand}" CommandParameter="{Binding}" />
                                            <Button Classes="tool" Content="Empty trash" IsVisible="{Binding CanEmpty}"
                                                    ToolTip.Tip="{Binding $parent[UserControl].((vm:CleanupViewModel)DataContext).EmptyTrashTip}"
                                                    Command="{Binding $parent[UserControl].((vm:CleanupViewModel)DataContext).EmptyTrashCommand}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
