<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             x:Class="NoIntrovert.Views.CleanupView"
             xmlns:v="using:NoIntrovert.Views"
             x:DataType="vm:CleanupViewModel"
             v:Responsive.Below="narrow:1000">
    <UserControl.Styles>
    </UserControl.Styles>
    <!--
        Organize (the Cleanup wizard, M7): the files in the list, each row's CHANGES column the dry run;
        a box per kind of step turns that kind on or off. Files Verify & match hasn't checked get a callout
        (Verify them now, or Use Optimize instead). Past runs, under the plan, can be undone, or their trash emptied.
    -->
    <!-- The list, and the side panel: a column, or below 880 px an overlay from the Details tab (SidePanelHost) -->
    <v:SidePanelHost Margin="0,10,0,0">
        <v:SidePanelHost.Main>
        <DockPanel>
            <!-- After a run that changed files: what it did, with Undo -->
            <v:LastRunBar DockPanel.Dock="Top" />
            <v:JobListPanel />
        </DockPanel>

        </v:SidePanelHost.Main>
        <v:SidePanelHost.Panel>
        <ScrollViewer Classes="sidepanel" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <Border Classes="card">
                    <v:SelectedFilePanel DataContext="{Binding SelectedFile}" />
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="THE PLAN" Classes="section" />
                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                   Text="Only files Verify recognized are renamed and moved; Optimize verifies them first. Nothing changes until you click Organize." />
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding PlanSummary}"
                                   IsVisible="{Binding PlanSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <!-- Files Verify & match hasn't checked are left alone: check them now, or use Optimize, which checks first -->
                        <Border x:Name="UncheckedCallout" IsVisible="{Binding HasUnchecked}" Padding="12,10" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource PrimaryTint}" BorderBrush="{DynamicResource AccentBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding UncheckedText}" TextWrapping="Wrap" />
                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                    <Button x:Name="VerifyNowButton" Classes="primary" Content="Verify them now" Command="{Binding VerifyNowCommand}"
                                            ToolTip.Tip="Check these files against the No-Intro and Redump databases, then make the plan again. You stay on Organize." />
                                    <Button x:Name="UseOptimizeButton" Content="Use Optimize instead" Command="{Binding UseOptimizeCommand}"
                                            ToolTip.Tip="Optimize checks each file first, then converts, names and moves it in one click." />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPlanning}">
                            <ProgressBar IsIndeterminate="True" Width="60" Height="6" VerticalAlignment="Center" />
                            <TextBlock Text="Making the plan…" Classes="hint" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- One box per kind of step, with its count: ticks or unticks them all, half-ticked when only some are -->
                        <ItemsControl x:Name="KindToggles" ItemsSource="{Binding Kinds}" IsVisible="{Binding HasRunnableSteps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CleanupKindToggle">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" Command="{Binding ToggleCommand}" Content="{Binding Label}"
                                              ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding AccessibleName}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="BusyStatus" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                            <ProgressBar IsIndeterminate="True" Width="60" Height="6" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BusyText}" Classes="hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <v:PastRunsPanel />
                </Border>
                <Border Classes="card">
                    <v:OrganizeOptionsPanel DataContext="{Binding Options}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        </v:SidePanelHost.Panel>
    </v:SidePanelHost>
</UserControl>
