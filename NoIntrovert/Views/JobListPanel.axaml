<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             xmlns:v="using:NoIntrovert.Views"
             xmlns:c="using:NoIntrovert.Controls"
             xmlns:presets="using:NoIntrovert.Core.Presets"
             x:Class="NoIntrovert.Views.JobListPanel"
             x:DataType="vm:BatchTabViewModel">

    <!-- A beam runs around the card while the batch runs -->
    <c:GlowBorder IsActive="{Binding IsRunning}">
    <Border Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- Toolbar -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,10,12,8">
                <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding IsIdle}">
                    <Button Classes="tool" Content="Add files…" Command="{Binding AddFilesCommand}" />
                    <Button Classes="tool" Content="Add folder…" Command="{Binding AddFolderCommand}" />
                    <!-- Convert only -->
                    <Button Classes="tool" Content="Pack a folder…" Command="{ReflectionBinding PackFolderCommand}" IsVisible="{Binding ShowsTargets}"
                            ToolTip.Tip="Add a folder as one row, to pack whole into 7z or zip without looking inside it." />
                    <Button Classes="tool" Content="Remove" Command="{Binding RemoveSelectedCommand}"
                            ToolTip.Tip="Remove the selected rows from the list (files are not touched)." />
                    <Button Classes="tool" Content="Clear finished" Command="{Binding ClearFinishedCommand}" />
                    <Button Classes="tool" Content="Clear all" Command="{Binding ClearAllCommand}" />
                </StackPanel>
                <!-- The filter stays usable during a run: that's when you look for what failed. -->
                <TextBox Grid.Column="1" Text="{Binding Filter}" PlaceholderText="Filter rows…" MinWidth="140" MaxWidth="260"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"
                         ToolTip.Tip="Shows only rows whose name, folder, target or status contains every word. Ctrl+A then selects just those. A run still converts every row, shown or not." />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" IsVisible="{Binding !IsScanning}">
                    <TextBlock Text="{Binding Summary}" Classes="hint" TextWrapping="NoWrap" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding FilterNote}" Classes="hint" FontSize="11" TextWrapping="NoWrap" HorizontalAlignment="Right"
                               IsVisible="{Binding FilterNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsScanning}">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="6" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ScanStatus}" Classes="hint" VerticalAlignment="Center" />
                    <Button Classes="tool" Content="Stop" Command="{Binding CancelScanCommand}" />
                </StackPanel>
            </Grid>

            <!-- Column headings -->
            <Grid Grid.Row="1" ColumnDefinitions="28,2*,50,Auto,75,90,140,50,1.3*" Margin="22,0,22,4">
                <!-- Select all: – when only some rows are selected -->
                <CheckBox x:Name="SelectAll" IsChecked="{Binding AllSelected, Mode=OneWay}" MinWidth="0" Padding="0"
                          VerticalAlignment="Center" ToolTip.Tip="Select every row shown, or none" />
                <TextBlock Grid.Column="1" Text="FILE" Classes="colhead" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="TYPE" Classes="colhead" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="PRESET" Classes="colhead" Width="150" Margin="0,0,8,0" IsVisible="{Binding ShowsTargets}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="SIZE" Classes="colhead" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="STATUS" Classes="colhead" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="PROGRESS" Classes="colhead" VerticalAlignment="Center" />
                <TextBlock Grid.Column="7" Text="TIME" Classes="colhead" VerticalAlignment="Center" />
                <TextBlock Grid.Column="8" Text="RESULT" Classes="colhead" VerticalAlignment="Center" />
            </Grid>

            <!-- Items -->
            <Panel Grid.Row="2">
                <ListBox x:Name="List" ItemsSource="{Binding VisibleItems}" SelectionMode="Multiple"
                         SelectedItems="{Binding SelectedItems}" Background="Transparent" Margin="10,0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                        <!-- Selected rows: a light lilac tint -->
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="#2E8F86D9" />
                        </Style>
                        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="#3D8F86D9" />
                        </Style>
                        <!-- The focused row: a stronger fill, a 2 px orange outline and a 4 px orange bar on its left -->
                        <Style Selector="Border.rowframe">
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="Padding" Value="10,3" />
                        </Style>
                        <Style Selector="Border.rowframe.focused">
                            <Setter Property="BorderBrush" Value="#FF8C42" />
                            <Setter Property="Background" Value="#338F86D9" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:JobItemViewModel">
                            <Panel>
                            <Border Classes="rowframe" Classes.focused="{Binding IsFocusedRow}">
                            <Grid ColumnDefinitions="28,2*,50,Auto,75,90,140,50,1.3*" ToolTip.Tip="{Binding Path}">
                                <CheckBox IsChecked="{Binding $parent[ListBoxItem].IsSelected}" MinWidth="0" Padding="0" VerticalAlignment="Center"
                                          Focusable="False" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Folder}" Classes="hint" FontSize="11" TextWrapping="NoWrap" TextTrimming="LeadingCharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding TypeText}" VerticalAlignment="Center" Classes="hint" />
                                <StackPanel Grid.Column="3" Width="150" Margin="0,0,8,0" VerticalAlignment="Center"
                                            IsVisible="{Binding $parent[ListBox].((vm:BatchTabViewModel)DataContext).ShowsTargets}">
                                    <ComboBox ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding PresetChoice}" IsVisible="{Binding HasPresets}"
                                              HorizontalAlignment="Stretch" MaxDropDownHeight="520"
                                              ToolTip.Tip="This file's preset: its format and settings.">
                                        <ComboBox.Styles>
                                            <Style Selector="ComboBoxItem" x:DataType="presets:PresetListItem">
                                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                            </Style>
                                        </ComboBox.Styles>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="presets:PresetListItem">
                                                <v:PresetOptionView />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBox.SelectionBoxItemTemplate>
                                            <DataTemplate x:DataType="presets:PresetListItem">
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.SelectionBoxItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding Target}" IsVisible="{Binding !HasPresets}" Classes="hint" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FormatStatus}" Classes="hint" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding FormatDetails}" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={x:Static v:Palette.StatusBrush}}" />
                                    <TextBlock Text="{Binding StatusText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6" MinWidth="0" />
                                    <TextBlock Text="{Binding Stage}" Classes="hint" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="7" Text="{Binding ElapsedText}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Result}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Details}" />
                                    <TextBlock Text="{Binding SpeedText}" Classes="hint" FontSize="11" TextWrapping="NoWrap" />
                                </StackPanel>
                            </Grid>
                            </Border>
                            <Border Width="4" HorizontalAlignment="Left" Background="#FF8C42" CornerRadius="4,0,0,4" IsVisible="{Binding IsFocusedRow}" />
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel IsVisible="{Binding NoMatches}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="No rows match the filter." Classes="hint" FontSize="13" HorizontalAlignment="Center" />
                    <Button Classes="tool" Content="Clear the filter" Command="{Binding ClearFilterCommand}" HorizontalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding EmptyHint}" IsVisible="{Binding !HasItems}" Classes="hint" FontSize="13"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30" />
            </Panel>

            <!-- Run bar -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                        <ProgressBar Value="{Binding OverallProgress}" Height="8" IsVisible="{Binding IsRunning}" />
                        <TextBlock Text="{Binding RunStatus}" Classes="hint" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <!-- Save to, on the pages that write files -->
                        <v:RunOptions IsVisible="{Binding ShowsSaveTo}" IsEnabled="{Binding IsIdle}" Margin="0,0,10,0" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                        <!-- Pulses while there's a list ready to start -->
                        <c:GlowBorder Mode="Pulse" Palette="Cool" GlowSize="12">
                            <c:GlowBorder.IsActive>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="HasItems" />
                                    <Binding Path="IsIdle" />
                                </MultiBinding>
                            </c:GlowBorder.IsActive>
                            <Button Classes="primary" Content="{Binding StartLabel}" Command="{Binding StartCommand}" />
                        </c:GlowBorder>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
    </c:GlowBorder>
</UserControl>
