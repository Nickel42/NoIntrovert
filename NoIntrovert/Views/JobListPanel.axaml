<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             xmlns:v="using:NoIntrovert.Views"
             x:Class="NoIntrovert.Views.JobListPanel"
             x:DataType="vm:BatchTabViewModel">

    <Border Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- Toolbar -->
            <Grid ColumnDefinitions="*,Auto" Margin="12,10,12,8">
                <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding IsIdle}">
                    <Button Classes="tool" Content="Add files…" Command="{Binding AddFilesCommand}" />
                    <Button Classes="tool" Content="Add folder…" Command="{Binding AddFolderCommand}" />
                    <Button Classes="tool" Content="Remove" Command="{Binding RemoveSelectedCommand}"
                            ToolTip.Tip="Remove the selected rows from the list (files are not touched)." />
                    <Button Classes="tool" Content="Clear finished" Command="{Binding ClearFinishedCommand}" />
                    <Button Classes="tool" Content="Clear all" Command="{Binding ClearAllCommand}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Summary}" Classes="hint" TextWrapping="NoWrap" VerticalAlignment="Center" />
            </Grid>

            <!-- Column headings -->
            <Grid Grid.Row="1" ColumnDefinitions="2*,50,Auto,75,90,140,50,1.3*" Margin="22,0,22,4">
                <TextBlock Text="FILE" Classes="colhead" />
                <TextBlock Grid.Column="1" Text="TYPE" Classes="colhead" />
                <TextBlock Grid.Column="2" Text="TARGET" Classes="colhead" Width="128" Margin="0,0,8,0" IsVisible="{Binding ShowsTargets}" />
                <TextBlock Grid.Column="3" Text="SIZE" Classes="colhead" HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock Grid.Column="4" Text="STATUS" Classes="colhead" />
                <TextBlock Grid.Column="5" Text="PROGRESS" Classes="colhead" />
                <TextBlock Grid.Column="6" Text="TIME" Classes="colhead" />
                <TextBlock Grid.Column="7" Text="RESULT" Classes="colhead" />
            </Grid>

            <!-- Items -->
            <Panel Grid.Row="2">
                <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectionMode="Multiple"
                         SelectedItems="{Binding SelectedItems}" Background="Transparent" Margin="10,0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="12,5" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:JobItemViewModel">
                            <Grid ColumnDefinitions="2*,50,Auto,75,90,140,50,1.3*" ToolTip.Tip="{Binding Path}">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Folder}" Classes="hint" FontSize="11" TextWrapping="NoWrap" TextTrimming="LeadingCharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding TypeText}" VerticalAlignment="Center" Classes="hint" />
                                <Panel Grid.Column="2" Width="128" Margin="0,0,8,0" VerticalAlignment="Center"
                                       IsVisible="{Binding $parent[ListBox].((vm:BatchTabViewModel)DataContext).ShowsTargets}">
                                    <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" IsVisible="{Binding HasTargets}"
                                              HorizontalAlignment="Stretch" ToolTip.Tip="What this row becomes. With several rows selected, the change applies to all of them." />
                                    <TextBlock Text="{Binding Target}" IsVisible="{Binding !HasTargets}" Classes="hint" VerticalAlignment="Center" />
                                </Panel>
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={x:Static v:Palette.StatusBrush}}" />
                                    <TextBlock Text="{Binding StatusText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6" MinWidth="0" />
                                    <TextBlock Text="{Binding Stage}" Classes="hint" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="6" Text="{Binding ElapsedText}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="7" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Result}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Details}" />
                                    <TextBlock Text="{Binding SpeedText}" Classes="hint" FontSize="11" TextWrapping="NoWrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding EmptyHint}" IsVisible="{Binding !HasItems}" Classes="hint" FontSize="13"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30" />
            </Panel>

            <!-- Run bar -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                        <ProgressBar Value="{Binding OverallProgress}" Height="8" IsVisible="{Binding IsRunning}" />
                        <TextBlock Text="{Binding RunStatus}" Classes="hint" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                        <Button Classes="primary" Content="{Binding StartLabel}" Command="{Binding StartCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
