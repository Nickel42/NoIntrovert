<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             xmlns:v="using:NoIntrovert.Views"
             xmlns:c="using:NoIntrovert.Controls"
             xmlns:presets="using:NoIntrovert.Core.Presets"
             x:Class="NoIntrovert.Views.JobListPanel"
             x:DataType="vm:BatchTabViewModel"
             v:Responsive.Below="medium:1100,compact:900,narrow:700">

    <UserControl.Styles>
        <!-- Column widths, shared by the headings and the rows; the file name takes what's left.
             As the list narrows it drops Type, Time and Size, then Progress, then Result
             (the side panel and each row's tooltip still have them). -->
        <Style Selector=":is(Control).col-type"><Setter Property="Width" Value="50" /></Style>
        <Style Selector=":is(Control).col-size"><Setter Property="Width" Value="76" /></Style>
        <Style Selector=":is(Control).col-status"><Setter Property="Width" Value="104" /></Style>
        <Style Selector=":is(Control).col-progress"><Setter Property="Width" Value="120" /></Style>
        <Style Selector=":is(Control).col-time"><Setter Property="Width" Value="56" /></Style>
        <Style Selector=":is(Control).col-result"><Setter Property="Width" Value="220" /></Style>

        <Style Selector="v|JobListPanel.medium :is(Control).col-type"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="v|JobListPanel.medium :is(Control).col-time"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="v|JobListPanel.medium :is(Control).col-size"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="v|JobListPanel.medium :is(Control).col-progress"><Setter Property="Width" Value="110" /></Style>
        <Style Selector="v|JobListPanel.medium :is(Control).col-result"><Setter Property="Width" Value="200" /></Style>
        <Style Selector="v|JobListPanel.compact :is(Control).col-progress"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="v|JobListPanel.compact :is(Control).col-result"><Setter Property="Width" Value="160" /></Style>
        <Style Selector="v|JobListPanel.narrow :is(Control).col-result"><Setter Property="IsVisible" Value="False" /></Style>

        <!-- A failed row's reason -->
        <Style Selector="TextBlock.failed"><Setter Property="Foreground" Value="#FF6F6B" /></Style>

        <!-- Run bar: progress and status at the left, then Save to, then Cancel and Convert.
             When the list is narrow, the status moves under the rest. -->
        <Style Selector="StackPanel.runstatus">
            <Setter Property="Width" Value="320" />
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style Selector="v|JobListPanel.medium StackPanel.runstatus"><Setter Property="Width" Value="220" /></Style>
        <Style Selector="v|JobListPanel.compact StackPanel.runstatus">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="DockPanel.Dock" Value="Bottom" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style Selector="v|JobListPanel.narrow TextBlock.savetolabel"><Setter Property="IsVisible" Value="False" /></Style>
    </UserControl.Styles>

    <!-- A beam runs around the card while the batch runs -->
    <c:GlowBorder IsActive="{Binding IsRunning}">
    <Border Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- Toolbar -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="12,10,12,8">
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                    <Button Classes="tool" Content="Add files…" Command="{Binding AddFilesCommand}" IsEnabled="{Binding IsIdle}" />
                    <Button Classes="tool" Content="Add folder…" Command="{Binding AddFolderCommand}" IsEnabled="{Binding IsIdle}" />
                    <!-- Convert only -->
                    <Button Classes="tool" Content="Pack a folder…" Command="{ReflectionBinding PackFolderCommand}" IsVisible="{Binding ShowsTargets}"
                            IsEnabled="{Binding IsIdle}"
                            ToolTip.Tip="Add a folder as one row, to pack whole into 7z or zip without looking inside it." />
                    <Button Classes="tool" Content="Remove" Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding IsIdle}"
                            ToolTip.Tip="Remove the selected rows from the list (files are not touched)." />
                    <Button Classes="tool" Content="Clear finished" Command="{Binding ClearFinishedCommand}" IsEnabled="{Binding IsIdle}" />
                    <Button Classes="tool" Content="Clear all" Command="{Binding ClearAllCommand}" IsEnabled="{Binding IsIdle}" />
                    <!-- The filter stays usable during a run: that's when you look for what failed. -->
                    <TextBox Text="{Binding Filter}" PlaceholderText="Filter rows…" Width="240" VerticalAlignment="Center" Margin="4,0,0,0"
                             ToolTip.Tip="Shows only rows whose name, folder, target or status contains every word. Ctrl+A then selects just those. A run still converts every row, shown or not.">
                        <TextBox.InnerLeftContent>
                            <!-- Search icon -->
                            <Path Width="16" Height="16" Margin="10,0,2,0" VerticalAlignment="Center" Stretch="None"
                                  Data="M6.5,1.5 A5,5 0 1 1 6.49,1.5 Z M10.2,10.2 L14.5,14.5"
                                  Stroke="{DynamicResource SubtleText}" StrokeThickness="1.6" StrokeLineCap="Round" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                </WrapPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding !IsScanning}">
                    <TextBlock Text="{Binding Summary}" Classes="hint" TextWrapping="NoWrap" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding FilterNote}" Classes="hint" FontSize="11" TextWrapping="NoWrap" HorizontalAlignment="Right"
                               IsVisible="{Binding FilterNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsScanning}" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="60" Height="6" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ScanStatus}" Classes="hint" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                    <Button Classes="tool" Content="Stop" Command="{Binding CancelScanCommand}" />
                </StackPanel>
            </Grid>

            <!-- Column headings -->
            <Grid Grid.Row="1" ColumnDefinitions="28,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="22,0,22,4">
                <!-- Select all: – when only some rows are selected -->
                <CheckBox x:Name="SelectAll" IsChecked="{Binding AllSelected, Mode=OneWay}" MinWidth="0" Padding="0"
                          VerticalAlignment="Center" ToolTip.Tip="Select every row shown, or none" />
                <TextBlock Grid.Column="1" Text="FILE" Classes="colhead" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="TYPE" Classes="colhead col-type" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="PRESET" Classes="colhead" Width="150" Margin="0,0,8,0" IsVisible="{Binding ShowsTargets}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="SIZE" Classes="colhead col-size" TextAlignment="Right" Padding="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="STATUS" Classes="colhead col-status" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="PROGRESS" Classes="colhead col-progress" VerticalAlignment="Center" />
                <TextBlock Grid.Column="7" Text="TIME" Classes="colhead col-time" VerticalAlignment="Center" />
                <TextBlock Grid.Column="8" Text="RESULT" Classes="colhead col-result" VerticalAlignment="Center" />
            </Grid>

            <!-- Items -->
            <Panel Grid.Row="2">
                <!-- The list hands its SelectedItems to the page in code (JobListPanel.axaml.cs) -->
                <ListBox x:Name="List" ItemsSource="{Binding VisibleItems}" SelectionMode="Multiple"
                         Background="Transparent" Margin="10,0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                        <!-- Selected rows: a light lilac tint -->
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="#2E8F86D9" />
                        </Style>
                        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="#3D8F86D9" />
                        </Style>
                        <!-- The focused row: a stronger fill, a 2 px orange outline and a 4 px orange bar on its left -->
                        <Style Selector="Border.rowframe">
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="Padding" Value="10,3" />
                        </Style>
                        <Style Selector="Border.rowframe.focused">
                            <Setter Property="BorderBrush" Value="#FF8C42" />
                            <Setter Property="Background" Value="#338F86D9" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:JobItemViewModel">
                            <Panel>
                            <Border Classes="rowframe" Classes.focused="{Binding IsFocusedRow}">
                            <Grid ColumnDefinitions="28,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ToolTip.Tip="{Binding Path}">
                                <CheckBox IsChecked="{Binding $parent[ListBoxItem].IsSelected}" MinWidth="0" Padding="0" VerticalAlignment="Center"
                                          Focusable="False" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Folder}" Classes="hint" FontSize="11" TextWrapping="NoWrap" TextTrimming="LeadingCharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding TypeText}" VerticalAlignment="Center" Classes="hint col-type" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="3" Width="150" Margin="0,0,8,0" VerticalAlignment="Center"
                                            IsVisible="{Binding $parent[ListBox].((vm:BatchTabViewModel)DataContext).ShowsTargets}">
                                    <ComboBox ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding PresetChoice}" IsVisible="{Binding HasPresets}"
                                              HorizontalAlignment="Stretch" MaxDropDownHeight="520"
                                              ToolTip.Tip="This file's preset: its format and settings.">
                                        <ComboBox.Styles>
                                            <Style Selector="ComboBoxItem" x:DataType="presets:PresetListItem">
                                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                            </Style>
                                        </ComboBox.Styles>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="presets:PresetListItem">
                                                <v:PresetOptionView />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBox.SelectionBoxItemTemplate>
                                            <DataTemplate x:DataType="presets:PresetListItem">
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.SelectionBoxItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding Target}" IsVisible="{Binding !HasPresets}" Classes="hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <!-- "Convert → .chd", or "Optimal" when left as is -->
                                    <TextBlock Text="{Binding PresetNote}" Classes="hint" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Margin="2,3,0,0" ToolTip.Tip="{Binding FormatDetails}" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding SizeText}" VerticalAlignment="Center" TextAlignment="Right" Padding="0,0,10,0" Classes="col-size" />
                                <DockPanel Grid.Column="5" VerticalAlignment="Center" Classes="col-status">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding Status, Converter={x:Static v:Palette.StatusBrush}}" />
                                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                </DockPanel>
                                <StackPanel Grid.Column="6" VerticalAlignment="Center" Classes="col-progress">
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6" MinWidth="0" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Stage}" Classes="hint" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="7" Text="{Binding ElapsedText}" VerticalAlignment="Center" Classes="col-time" />
                                <StackPanel Grid.Column="8" VerticalAlignment="Center" Classes="col-result">
                                    <!-- "Game.chd · 58%", or a failure's reason in red; the speed below -->
                                    <TextBlock Text="{Binding Result}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Details}"
                                               Classes.failed="{Binding IsFailed}" />
                                    <TextBlock Text="{Binding SpeedText}" Classes="hint" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            </Border>
                            <Border Width="4" HorizontalAlignment="Left" Background="#FF8C42" CornerRadius="4,0,0,4" IsVisible="{Binding IsFocusedRow}" />
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel IsVisible="{Binding NoMatches}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="No rows match the filter." Classes="hint" FontSize="13" HorizontalAlignment="Center" />
                    <Button Classes="tool" Content="Clear the filter" Command="{Binding ClearFilterCommand}" HorizontalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding EmptyHint}" IsVisible="{Binding !HasItems}" Classes="hint" FontSize="13"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30" />
            </Panel>

            <!-- Run bar -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="12,10">
                <DockPanel>
                    <!-- The run's progress and status: "Working on 7 item(s)…" -->
                    <StackPanel Classes="runstatus" VerticalAlignment="Center" Spacing="6">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="IsRunning" />
                                <Binding Path="RunStatus" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <ProgressBar Value="{Binding OverallProgress}" Height="8" MinWidth="0" IsVisible="{Binding IsRunning}" />
                        <TextBlock Text="{Binding RunStatus}" Classes="hint" TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- Cancel and Convert, at the right -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" />
                        <!-- Pulses while there's a list ready to start -->
                        <c:GlowBorder Mode="Pulse" Palette="Cool" GlowSize="12">
                            <c:GlowBorder.IsActive>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="HasItems" />
                                    <Binding Path="IsIdle" />
                                </MultiBinding>
                            </c:GlowBorder.IsActive>
                            <Button Classes="primary" Content="{Binding StartLabel}" Command="{Binding StartCommand}" />
                        </c:GlowBorder>
                    </StackPanel>
                    <!-- Save to, on the pages that write files: what's left between them -->
                    <Grid Classes="saveto" ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalAlignment="Center"
                          IsVisible="{Binding ShowsSaveTo}">
                        <TextBlock Classes="savetolabel" Text="Save to" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PanelHeadText}" />
                        <v:RunOptions Grid.Column="1" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
    </c:GlowBorder>
</UserControl>
