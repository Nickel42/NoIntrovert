<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             xmlns:v="using:NoIntrovert.Views"
             x:Class="NoIntrovert.Views.WiiUView"
             x:DataType="vm:WiiUViewModel">
    <Grid ColumnDefinitions="*,310" ColumnSpacing="12" Margin="0,10,0,0">
        <v:JobListPanel />

        <ScrollViewer Grid.Column="1">
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Text="WII U ARCHIVES (.WUA)" Classes="section" Margin="0,0,0,4" />
                    <TextBlock Classes="hint"
                               Text="Builds Cemu's .wua format: one compressed, decrypted file per game holding the base game, its newest update and its DLC." />

                    <TextBlock Text="WHAT IT READS" Classes="section" />
                    <TextBlock Classes="hint"
                               Text="• Extracted title folders (code, content and meta inside)&#10;• .wua files, to merge in an update or DLC, or to repack" />
                    <TextBlock Classes="hint"
                               Text="Encrypted NUS folders and WUD/WUX disc images aren't supported yet; they're listed and skipped." />

                    <TextBlock Text="CHECKS" Classes="section" />
                    <TextBlock Classes="hint"
                               Text="Every new .wua is reopened, its SHA-256 checked, and every file decompressed and compared with its source before it replaces anything." />

                    <TextBlock Text="AFTERWARDS" Classes="section" />
                    <CheckBox Content="Remove the originals once the .wua verifies" IsChecked="{Binding Settings.WiiUDeleteOriginals}"
                              ToolTip.Tip="Removes the title folders and older .wua files that went into the new .wua. A .wua rebuilt under its own name is replaced in place." />
                    <CheckBox Content="{Binding Settings.RecycleBinLabel}" IsChecked="{Binding Settings.UseRecycleBin}"
                              IsVisible="{Binding Settings.CanUseRecycleBin}" IsEnabled="{Binding Settings.WiiUDeleteOriginals}" Margin="22,0,0,0" />

                    <Separator Margin="0,10" />
                    <ContentControl Content="{Binding Settings}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:SettingsViewModel"><v:SharedOptions /></DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
