<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             xmlns:v="using:NoIntrovert.Views"
             x:Class="NoIntrovert.Views.WiiUView"
             x:DataType="vm:WiiUViewModel">
    <Grid ColumnDefinitions="*,310" ColumnSpacing="12" Margin="0,10,0,0">
        <v:JobListPanel />

        <ScrollViewer Grid.Column="1">
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Text="WII U ARCHIVES (.WUA)" Classes="section" Margin="0,0,0,4" />
                    <TextBlock Classes="hint"
                               Text="Builds Cemu's .wua format: one compressed, decrypted file per game holding the base game, its newest update and its DLC." />

                    <TextBlock Text="WHAT IT READS" Classes="section" />
                    <TextBlock Classes="hint"
                               Text="• Extracted title folders (code, content and meta inside)&#10;• NUS / installable titles (title.tmd, title.tik, .app files)&#10;• WUD and WUX disc images, including split game_part1.wud dumps&#10;• .wua files, to merge in an update or DLC, or to repack" />

                    <TextBlock Text="KEYS" Classes="section" />
                    <TextBlock Classes="hint"
                               Text="Encrypted titles and disc images need your own keys.txt (the same file Cemu uses: the Wii U common key and your discs' keys). NoIntrovert doesn't include any keys." />
                    <TextBlock Classes="hint" Text="{Binding Settings.Keys.WiiUKeysSummary}" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="tool" Content="Choose keys.txt…" Command="{Binding Settings.Keys.BrowseWiiUKeysCommand}" Margin="0,0,6,6" />
                        <Button Classes="tool" Content="Find automatically" Command="{Binding Settings.Keys.FindWiiUKeysAutomaticallyCommand}" Margin="0,0,6,6" />
                        <Button Classes="tool" Content="Refresh" Command="{Binding Settings.Keys.RefreshWiiUKeysCommand}" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock Classes="hint"
                               Text="A disc key can also sit next to its image as game.key (16 bytes)." />

                    <TextBlock Text="CHECKS" Classes="section" />
                    <TextBlock Classes="hint"
                               Text="Encrypted data is checked as it's decrypted (every hashed block, and NUS contents against their TMD). Every new .wua is then reopened, its SHA-256 checked, and every file decompressed and compared with its source before it replaces anything." />

                    <TextBlock Text="AFTERWARDS" Classes="section" />
                    <CheckBox Content="Remove the originals once the .wua verifies" IsChecked="{Binding Settings.Output.RemoveWiiUOriginals}"
                              ToolTip.Tip="Removes the title folders and older .wua files that went into the new .wua. A .wua rebuilt under its own name is replaced in place." />
                    <CheckBox Content="{Binding Settings.Output.RecycleBinLabel}" IsChecked="{Binding Settings.Output.UseRecycleBin}"
                              IsVisible="{Binding Settings.Output.CanUseRecycleBin}" IsEnabled="{Binding Settings.Output.RemoveWiiUOriginals}" Margin="22,0,0,0" />

                    <Separator Margin="0,10" />
                    <v:RunOptions />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
