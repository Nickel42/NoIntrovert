<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             xmlns:v="using:NoIntrovert.Views"
             x:Class="NoIntrovert.Views.VerifyView"
             x:DataType="vm:VerifyViewModel">
    <Grid ColumnDefinitions="*,310" ColumnSpacing="12" Margin="0,10,0,0">
        <v:JobListPanel />

        <ScrollViewer Grid.Column="1">
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Text="VERIFY &amp; MATCH" Classes="section" Margin="0,0,0,4" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Each game is checked for damage first (CHDs against their stored SHA-1, 7z and zip by testing every file), then hashed and looked up in the No-Intro and Redump databases. Hashes are remembered, so an unchanged file is never hashed twice." />

                    <TextBlock Text="GAME DATABASES" Classes="section" />
                    <TextBlock Classes="hint" Text="{Binding Settings.Dats.Status}" TextWrapping="Wrap" />
                    <Button Classes="tool" Content="Update now" Command="{Binding Settings.Dats.UpdateNowCommand}" HorizontalAlignment="Left"
                            ToolTip.Tip="Download newer databases from libretro-database for the systems in your Library" />

                    <v:PresetPicker DataContext="{Binding Settings.Presets.Verify}" Margin="0,8,0,0" />

                    <Separator Margin="0,10" />
                    <v:RunOptions />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
