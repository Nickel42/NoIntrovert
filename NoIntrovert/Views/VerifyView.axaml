<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             xmlns:v="using:NoIntrovert.Views"
             x:Class="NoIntrovert.Views.VerifyView"
             x:DataType="vm:VerifyViewModel">
    <Grid ColumnDefinitions="*,310" ColumnSpacing="12" Margin="0,10,0,0">
        <v:JobListPanel />

        <ScrollViewer Grid.Column="1">
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Text="VERIFY CHDS" Classes="section" Margin="0,0,0,4" />
                    <TextBlock Classes="hint"
                               Text="Reads every hunk, decompresses it and checks the result against the SHA-1 stored in the CHD header." />

                    <TextBlock Text="OPTIONS" Classes="section" />
                    <CheckBox Content="Fix a wrong header SHA-1" IsChecked="{Binding Settings.FixHeaderSha1}"
                              ToolTip.Tip="Rewrites the SHA-1 in the header when the data is intact but the stored hash is wrong (chdman verify --fix)." />
                    <TextBlock Classes="hint" Text="Fixing changes the CHD file in place." IsVisible="{Binding Settings.FixHeaderSha1}" />

                    <Separator Margin="0,10" />
                    <ContentControl Content="{Binding Settings}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:SettingsViewModel"><v:SharedOptions /></DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
