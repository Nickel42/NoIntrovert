<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             xmlns:v="using:NoIntrovert.Views"
             x:Class="NoIntrovert.Views.ArchiveView"
             x:DataType="vm:ArchiveViewModel">
    <Grid ColumnDefinitions="*,310" ColumnSpacing="12" Margin="0,10,0,0">
        <v:JobListPanel />

        <ScrollViewer Grid.Column="1">
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Text="ARCHIVES" Classes="section" Margin="0,0,0,4" />
                    <TextBlock Classes="hint" Text="7z and zip archives, made and checked with 7-Zip's own engine (through bit7z)." />

                    <TextBlock Text="ACTION" Classes="section" />
                    <ComboBox ItemsSource="{x:Static vm:ArchiveSettingsViewModel.Actions}"
                              SelectedItem="{Binding Settings.Archives.SelectedAction}" HorizontalAlignment="Stretch" />

                    <!-- Compress -->
                    <StackPanel Spacing="4" IsVisible="{Binding Settings.Archives.IsCompress}">
                        <TextBlock Text="FORMAT" Classes="section" />
                        <ComboBox ItemsSource="{x:Static vm:ArchiveSettingsViewModel.Formats}"
                                  SelectedItem="{Binding Settings.Archives.SelectedFormat}" HorizontalAlignment="Stretch" />

                        <TextBlock Text="ARCHIVES TO MAKE" Classes="section" />
                        <ComboBox ItemsSource="{x:Static vm:ArchiveSettingsViewModel.Groupings}"
                                  SelectedItem="{Binding Settings.Archives.SelectedGrouping}" HorizontalAlignment="Stretch" />
                        <TextBox Text="{Binding Settings.Archives.SingleName}" PlaceholderText="Name of the combined archive"
                                 IsVisible="{Binding Settings.Archives.IsSingle}" />
                        <TextBlock Classes="hint"
                                   Text="Files are named after themselves without their extension (game.iso → game.7z); folders after the folder." />
                    </StackPanel>

                    <!-- Convert -->
                    <StackPanel Spacing="4" IsVisible="{Binding Settings.Archives.IsConvert}">
                        <TextBlock Text="CONVERT TO" Classes="section" />
                        <ComboBox ItemsSource="{x:Static vm:ArchiveSettingsViewModel.ConvertTargets}"
                                  SelectedItem="{Binding Settings.Archives.SelectedConvertTarget}" HorizontalAlignment="Stretch" />
                        <TextBlock Classes="hint"
                                   Text="Each archive is unpacked into the temp folder and packed again, keeping its folder layout." />
                    </StackPanel>

                    <!-- Extract -->
                    <StackPanel Spacing="4" IsVisible="{Binding Settings.Archives.IsExtract}">
                        <TextBlock Text="WHERE FILES GO" Classes="section" />
                        <CheckBox Content="Put each archive in its own folder" IsChecked="{Binding Settings.Archives.ExtractToOwnFolder}"
                                  ToolTip.Tip="game.7z unpacks into a folder called game. Off, the files go straight into the output folder." />
                        <TextBlock Classes="hint"
                                   Text="Files that already exist are kept unless Overwrite is on. 7-Zip checks every file's CRC while extracting, so a clean extraction also tests the archive." />
                    </StackPanel>

                    <StackPanel Spacing="4" IsVisible="{Binding Settings.Archives.IsWriting}">
                        <TextBlock Text="COMPRESSION" Classes="section" />
                        <ComboBox ItemsSource="{x:Static vm:ArchiveSettingsViewModel.Levels}"
                                  SelectedItem="{Binding Settings.Archives.SelectedLevel}" HorizontalAlignment="Stretch" />
                        <CheckBox Content="Solid 7z archive (smaller, slower to open one file)" IsChecked="{Binding Settings.Archives.Solid}"
                                  IsVisible="{Binding Settings.Archives.IsSevenZip}" />
                    </StackPanel>

                    <TextBlock Text="AFTERWARDS" Classes="section" />
                    <CheckBox Content="Test each new archive" IsChecked="{Binding Settings.Archives.TestAfter}"
                              IsVisible="{Binding Settings.Archives.IsWriting}"
                              ToolTip.Tip="Decompress every file in the new archive and check its CRC, as 7-Zip's Test does." />
                    <CheckBox Content="{Binding Settings.Archives.RemoveLabel}" IsChecked="{Binding Settings.Output.RemoveArchiveOriginals}"
                              ToolTip.Tip="Only after success: compressing removes the files and folders that went in once the new archive tests OK; converting removes the old archive; extracting removes the archive once every file is out." />
                    <CheckBox Content="{Binding Settings.Output.RecycleBinLabel}" IsChecked="{Binding Settings.Output.UseRecycleBin}"
                              IsVisible="{Binding Settings.Output.CanUseRecycleBin}" IsEnabled="{Binding Settings.Output.RemoveArchiveOriginals}" Margin="22,0,0,0" />
                    <TextBlock Classes="hint" Text="Removing originals always tests first, even if Test is off."
                               IsVisible="{Binding Settings.Output.RemoveArchiveOriginals}" />

                    <Separator Margin="0,10" />
                    <v:RunOptions />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
