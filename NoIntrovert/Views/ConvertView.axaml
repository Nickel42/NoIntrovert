<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             xmlns:v="using:NoIntrovert.Views"
             xmlns:presets="using:NoIntrovert.Core.Presets"
             x:Class="NoIntrovert.Views.ConvertView"
             x:DataType="vm:ConvertViewModel"
             v:Responsive.Below="compact:1250,narrow:1000,tight:860">
    <!-- The side panel's own colours (PanelTile, TagMedia…) come from the theme: Core/Themes/ThemeResources. -->
    <UserControl.Styles>
        <!-- The side panel: 440 px on a wide page, down to 280 px on the smallest window -->
        <Style Selector="Border.sidepanel"><Setter Property="Width" Value="440" /></Style>
        <Style Selector="v|ConvertView.compact Border.sidepanel"><Setter Property="Width" Value="360" /></Style>
        <Style Selector="v|ConvertView.narrow Border.sidepanel"><Setter Property="Width" Value="320" /></Style>
        <Style Selector="v|ConvertView.tight Border.sidepanel"><Setter Property="Width" Value="280" /></Style>

        <!-- The panel's text: section heads ("PRESET"), the note at their right ("For this file"), field labels -->
        <Style Selector="Border.sidepanel TextBlock.head">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PanelHeadText}" />
        </Style>
        <Style Selector="Border.sidepanel TextBlock.group">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PanelGroupText}" />
        </Style>
        <Style Selector="Border.sidepanel TextBlock.aside">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style Selector="Border.sidepanel TextBlock.label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.sidepanel Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource PanelBorder}" />
            <Setter Property="Margin" Value="0,14" />
        </Style>
        <Style Selector="Border.sidepanel ComboBox">
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <!-- A setting's warning: an orange-bordered box under it -->
        <Style Selector="Border.sidepanel Border.warning">
            <Setter Property="Background" Value="{DynamicResource WarningFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,4,0,2" />
        </Style>
        <Style Selector="Border.sidepanel Border.warning > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource WarningText}" />
        </Style>
    </UserControl.Styles>
    <!--
        One page for every conversion. Each row in the list has its own preset
        (a format plus its settings); the side panel, 440 px and as tall as the
        page, describes the focused row: File, Preset, then Preset settings
        when the row is on Custom. It scrolls as one panel.
    -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,10,0,0">
        <DockPanel>
            <!-- The CHD converter didn't load: say so, and what to do, above the list -->
            <Border x:Name="ChdMissingBanner" DockPanel.Dock="Top" IsVisible="{Binding ChdConverterMissing}" Margin="0,0,0,10" Padding="14,10"
                    Background="{DynamicResource WarningFill}" BorderBrush="{DynamicResource DangerText}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="The CHD converter (chdkit) is missing or blocked" FontWeight="Bold" Foreground="{DynamicResource DangerText}" TextWrapping="Wrap" />
                    <TextBlock Text="CHD files can't be made or checked. Reinstall NoIntrovert, or check whether your antivirus quarantined chdkit."
                               TextWrapping="Wrap" FontSize="13" />
                </StackPanel>
            </Border>
            <v:JobListPanel />
        </DockPanel>

        <Border Grid.Column="1" Classes="card sidepanel" Padding="0">
            <ScrollViewer DataContext="{Binding Panel}" x:DataType="vm:SidePanelViewModel" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="6" Margin="20,18">

                    <!-- File -->
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                        <TextBlock Text="SELECTED FILE" Classes="head" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Header}" Classes="aside" FontSize="12" ToolTip.Tip="{Binding Header}" />
                    </Grid>
                    <v:FileFacts DataContext="{Binding File}" />

                    <!-- Preset -->
                    <Border Classes="divider" />
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="PRESET" Classes="head" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="For this file" Classes="aside" FontSize="12" IsVisible="{Binding CanChoose}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Add files to choose how they're converted." IsVisible="{Binding !HasRow}" />
                    <StackPanel Spacing="6" IsVisible="{Binding HasRow}">
                        <WrapPanel Margin="0,4,0,0" ItemSpacing="10">
                            <TextBlock x:Name="PresetLabel" Text="Preset (format + settings)" Classes="label" />
                            <TextBlock Text="{Binding PresetCount}" Classes="aside" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </WrapPanel>
                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanChoose}"
                                  HorizontalAlignment="Stretch" MaxDropDownHeight="520" AutomationProperties.LabeledBy="{Binding #PresetLabel}">
                            <ComboBox.Styles>
                                <Style Selector="ComboBoxItem" x:DataType="presets:PresetListItem">
                                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                </Style>
                            </ComboBox.Styles>
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="presets:PresetListItem">
                                    <v:PresetOptionView />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate x:DataType="presets:PresetListItem">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="hint" FontSize="11" Text="Select a row to change its preset." IsVisible="{Binding !CanChoose}" />

                        <!-- Apply to N selected: the hint and the button side by side -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding ShowsApply}" Margin="0,4,0,0">
                            <TextBlock Text="{Binding ApplyHint}" Classes="hint" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="tool" Content="{Binding ApplyLabel}" Command="{Binding ApplyToSelectedCommand}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- Works with: the focused row's system and this preset's output -->
                        <v:WorksWithList DataContext="{Binding WorksWith}" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Preset settings, only for Custom -->
                    <StackPanel IsVisible="{Binding Custom, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Border Classes="divider" />
                        <v:PresetSettingsPanel DataContext="{Binding Custom}" />
                    </StackPanel>

                    <!-- Wii U: encrypted titles and discs need the user's own keys (also in Settings › Keys) -->
                    <StackPanel x:Name="WiiUKeys" Spacing="4" IsVisible="{Binding ShowsWiiUKeys}">
                        <Border Classes="divider" />
                        <TextBlock Text="WII U KEYS" Classes="head" />
                        <TextBlock Classes="hint" Text="{Binding Settings.Keys.WiiUKeysSummary}" TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal">
                            <Button Classes="tool" Content="Choose keys.txt…" Command="{Binding Settings.Keys.BrowseWiiUKeysCommand}" Margin="0,0,6,6" />
                            <Button Classes="tool" Content="Find automatically" Command="{Binding Settings.Keys.FindWiiUKeysAutomaticallyCommand}" Margin="0,0,6,6" />
                            <Button Classes="tool" Content="Refresh" Command="{Binding Settings.Keys.RefreshWiiUKeysCommand}" Margin="0,0,6,6" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- 3DS: encrypted games and .cia files need the user's own keys (also in Settings › Keys) -->
                    <StackPanel x:Name="ThreeDsKeys" Spacing="4" IsVisible="{Binding ShowsThreeDsKeys}">
                        <Border Classes="divider" />
                        <TextBlock Text="3DS KEYS" Classes="head" />
                        <TextBlock Classes="hint" Text="{Binding Settings.Keys.ThreeDsKeysSummary}" TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal">
                            <Button Classes="tool" Content="Choose a folder…" Command="{Binding Settings.Keys.BrowseThreeDsKeysCommand}" Margin="0,0,6,6"
                                    AutomationProperties.Name="Choose the 3DS keys folder" />
                            <Button Classes="tool" Content="Find automatically" Command="{Binding Settings.Keys.FindThreeDsKeysAutomaticallyCommand}" Margin="0,0,6,6"
                                    AutomationProperties.Name="Find 3DS keys automatically" />
                            <Button Classes="tool" Content="Refresh" Command="{Binding Settings.Keys.RefreshThreeDsKeysCommand}" Margin="0,0,6,6"
                                    AutomationProperties.Name="Refresh 3DS keys" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Switch: every conversion needs the user's own prod.keys (also in Settings › Keys) -->
                    <StackPanel x:Name="SwitchKeys" Spacing="4" IsVisible="{Binding ShowsSwitchKeys}">
                        <Border Classes="divider" />
                        <TextBlock Text="SWITCH KEYS" Classes="head" />
                        <TextBlock Classes="hint" Text="{Binding Settings.Keys.SwitchKeysSummary}" TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal">
                            <Button Classes="tool" Content="Choose prod.keys…" Command="{Binding Settings.Keys.BrowseSwitchKeysCommand}" Margin="0,0,6,6" />
                            <Button Classes="tool" Content="Find automatically" Command="{Binding Settings.Keys.FindSwitchKeysAutomaticallyCommand}" Margin="0,0,6,6"
                                    AutomationProperties.Name="Find Switch keys automatically" />
                            <Button Classes="tool" Content="Refresh" Command="{Binding Settings.Keys.RefreshSwitchKeysCommand}" Margin="0,0,6,6"
                                    AutomationProperties.Name="Refresh Switch keys" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- PS Vita: games and DLC need a zRIF (also in Settings › Keys); the package keys are built in -->
                    <StackPanel x:Name="VitaZrif" Spacing="4" IsVisible="{Binding ShowsVitaZrif}">
                        <Border Classes="divider" />
                        <TextBlock Text="PS VITA LICENSES" Classes="head" />
                        <TextBlock Classes="hint" Text="{Binding Settings.Keys.VitaZrifSummary}" TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal">
                            <Button Classes="tool" Content="Choose a zRIF list…" Command="{Binding Settings.Keys.BrowseVitaZrifCommand}" Margin="0,0,6,6" />
                            <Button Classes="tool" Content="Refresh" Command="{Binding Settings.Keys.RefreshVitaZrifCommand}" Margin="0,0,6,6"
                                    AutomationProperties.Name="Refresh the zRIF list" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
