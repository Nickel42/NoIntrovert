<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             xmlns:v="using:NoIntrovert.Views"
             x:Class="NoIntrovert.Views.ConvertView"
             x:DataType="vm:ConvertViewModel">
    <Grid ColumnDefinitions="*,310" ColumnSpacing="12" Margin="0,10,0,0">
        <v:JobListPanel />

        <ScrollViewer Grid.Column="1">
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Text="CONVERT TO CHD" Classes="section" Margin="0,0,0,4" />
                    <TextBlock Classes="hint"
                               Text="Archives, split files, ECM, CSO/ZSO, ISZ, PBP, CloneCD and Alcohol images are unpacked or rebuilt in the temp folder first, then compressed with libchdman." />

                    <TextBlock Text="COMPRESSION" Classes="section" />
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.CompressionChoices}"
                              SelectedItem="{Binding Settings.SelectedCompression}" HorizontalAlignment="Stretch" />
                    <TextBox Text="{Binding Settings.CustomCompression}" PlaceholderText="e.g. cdzs,cdzl,cdfl (up to four codecs)"
                             IsVisible="{Binding Settings.IsCustomCompression}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <TextBlock Text="Hunk size" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.HunkSizes}"
                                  SelectedItem="{Binding Settings.SelectedHunkSize}" HorizontalAlignment="Stretch" />
                    </Grid>

                    <TextBlock Text="ISO IMAGES" Classes="section" />
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.IsoModes}"
                              SelectedItem="{Binding Settings.SelectedIsoMode}" HorizontalAlignment="Stretch" />
                    <TextBlock Classes="hint" Text="PSP and PS2 images belong on DVD; CSO/ZSO are always treated as DVD in Auto." />

                    <TextBlock Text="AFTER CONVERTING" Classes="section" />
                    <CheckBox Content="Verify each CHD" IsChecked="{Binding Settings.VerifyAfterCreate}" />
                    <CheckBox Content="Remove the original files" IsChecked="{Binding Settings.DeleteOriginals}"
                              ToolTip.Tip="Only after the new CHD verifies. Includes the bins, tracks, archive volumes and split parts that belong to it." />
                    <CheckBox Content="{Binding Settings.RecycleBinLabel}" IsChecked="{Binding Settings.UseRecycleBin}" IsVisible="{Binding Settings.CanUseRecycleBin}"
                              IsEnabled="{Binding Settings.DeleteOriginals}" Margin="22,0,0,0" />
                    <TextBlock Classes="hint" Text="Removing originals always verifies first, even if Verify is off."
                               IsVisible="{Binding Settings.DeleteOriginals}" />

                    <Separator Margin="0,10" />
                    <ContentControl Content="{Binding Settings}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:SettingsViewModel"><v:SharedOptions /></DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <TextBlock Text="TEMP FOLDER" Classes="section" />
                    <TextBlock Classes="hint" Text="{Binding Settings.TempFolderHint}" TextTrimming="LeadingCharacterEllipsis" />
                    <Button Classes="tool" Content="Choose temp folder…" Command="{Binding Settings.BrowseTempFolderCommand}" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
