<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             xmlns:v="using:NoIntrovert.Views"
             x:Class="NoIntrovert.Views.ConvertView"
             x:DataType="vm:ConvertViewModel">
    <Grid ColumnDefinitions="*,310" ColumnSpacing="12" Margin="0,10,0,0">
        <v:JobListPanel />

        <ScrollViewer Grid.Column="1">
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Text="CONVERT" Classes="section" Margin="0,0,0,4" />
                    <TextBlock Classes="hint"
                               Text="Archives, split files, ECM, CSO/ZSO, ISZ, PBP, CloneCD and Alcohol images are unpacked or rebuilt in the temp folder first, then compressed with libchdman." />

                    <TextBlock Text="COMPRESSION" Classes="section" />
                    <ComboBox ItemsSource="{x:Static vm:ChdSettingsViewModel.CompressionChoices}"
                              SelectedItem="{Binding Settings.Chd.SelectedCompression}" HorizontalAlignment="Stretch" />
                    <TextBox Text="{Binding Settings.Chd.CustomCompression}" PlaceholderText="e.g. cdzs,cdzl,cdfl (up to four codecs)"
                             IsVisible="{Binding Settings.Chd.IsCustomCompression}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4,0,0" IsVisible="{Binding Settings.General.PowerUserMode}">
                        <TextBlock Text="Hunk size" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ChdSettingsViewModel.HunkSizes}"
                                  SelectedItem="{Binding Settings.Chd.SelectedHunkSize}" HorizontalAlignment="Stretch" />
                    </Grid>

                    <TextBlock Text="ISO IMAGES" Classes="section" />
                    <ComboBox ItemsSource="{x:Static vm:ChdSettingsViewModel.IsoModes}"
                              SelectedItem="{Binding Settings.Chd.SelectedIsoMode}" HorizontalAlignment="Stretch" />
                    <TextBlock Classes="hint" Text="PSP and PS2 images belong on DVD; CSO/ZSO are always treated as DVD in Auto." />

                    <TextBlock Text="GAMECUBE / WII" Classes="section" />
                    <ComboBox ItemsSource="{x:Static vm:NintendoSettingsViewModel.Targets}"
                              SelectedItem="{Binding Settings.Nintendo.SelectedTarget}" HorizontalAlignment="Stretch" />
                    <StackPanel Spacing="4" IsVisible="{Binding Settings.Nintendo.IsRvzTarget}">
                        <ComboBox ItemsSource="{x:Static vm:NintendoSettingsViewModel.Compressions}"
                                  SelectedItem="{Binding Settings.Nintendo.SelectedCompression}" HorizontalAlignment="Stretch" />
                        <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto" RowSpacing="6" Margin="0,4,0,0">
                            <TextBlock Text="Level" VerticalAlignment="Center" IsEnabled="{Binding Settings.Nintendo.HasLevel}" />
                            <NumericUpDown Grid.Column="1" Value="{Binding Settings.Nintendo.CompressionLevel}"
                                           Minimum="{Binding Settings.Nintendo.LevelMinimum}" Maximum="{Binding Settings.Nintendo.LevelMaximum}"
                                           Increment="1" FormatString="0" IsEnabled="{Binding Settings.Nintendo.HasLevel}" />
                            <TextBlock Grid.Row="1" Text="Block size" VerticalAlignment="Center" IsVisible="{Binding Settings.General.PowerUserMode}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" IsVisible="{Binding Settings.General.PowerUserMode}" ItemsSource="{x:Static vm:NintendoSettingsViewModel.BlockSizes}"
                                      SelectedItem="{Binding Settings.Nintendo.SelectedBlockSize}" HorizontalAlignment="Stretch" />
                        </Grid>
                        <CheckBox Content="Scrub unused data" IsChecked="{Binding Settings.Nintendo.Scrub}" IsVisible="{Binding Settings.General.PowerUserMode}"
                                  ToolTip.Tip="Zeroes the disc's padding first. RVZ already stores padding compactly, so this saves little, and the result no longer matches Redump checksums." />
                    </StackPanel>
                    <TextBlock Classes="hint"
                               Text="GameCube/Wii discs (iso, gcm, gcz, wia, rvz, tgc) go through Dolphin's own code (libdolphinrvz). RVZ round-trips to the exact original disc. WBFS and CISO can't be converted." />

                    <TextBlock Text="AFTER CONVERTING" Classes="section" />
                    <CheckBox Content="Verify each CHD or RVZ" IsChecked="{Binding Settings.Chd.VerifyAfterCreate}"
                              ToolTip.Tip="CHDs are checked against their stored SHA-1; RVZs are decoded again and compared with the source disc." />
                    <CheckBox Content="Remove the original files" IsChecked="{Binding Settings.Output.RemoveOriginals}"
                              ToolTip.Tip="Only after the new CHD or RVZ verifies. Includes the bins, tracks, archive volumes and split parts that belong to it." />
                    <CheckBox Content="{Binding Settings.Output.RecycleBinLabel}" IsChecked="{Binding Settings.Output.UseRecycleBin}" IsVisible="{Binding Settings.Output.CanUseRecycleBin}"
                              IsEnabled="{Binding Settings.Output.RemoveOriginals}" Margin="22,0,0,0" />
                    <TextBlock Classes="hint" Text="Removing originals always verifies first, even if Verify is off."
                               IsVisible="{Binding Settings.Output.RemoveOriginals}" />

                    <Separator Margin="0,10" />
                    <v:RunOptions />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
