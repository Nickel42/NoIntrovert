<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             xmlns:v="using:NoIntrovert.Views"
             x:Class="NoIntrovert.Views.ConvertView"
             x:DataType="vm:ConvertViewModel">
    <!--
        One page for every conversion. The list gives each row its own target
        (what it becomes); the panel shows a preset for each action those
        targets use (how), and an action's parameters only under Custom.
    -->
    <Grid ColumnDefinitions="*,320" ColumnSpacing="12" Margin="0,10,0,0">
        <v:JobListPanel />

        <ScrollViewer Grid.Column="1">
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Text="CONVERT" Classes="section" Margin="0,0,0,4" />
                    <TextBlock Classes="hint" Text="{Binding TargetSummary}" TextWrapping="Wrap" />
                    <Button Classes="tool" Content="Pack a folder…" Command="{Binding PackFolderCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            ToolTip.Tip="Add a folder as one row, to pack whole into 7z or zip without looking inside it." />

                    <!-- One preset per action the rows' targets use; parameters only under Custom (issue #33) -->
                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <Panel IsVisible="{Binding ShowsChd}"><v:PresetPicker DataContext="{Binding Settings.Presets.Chd}" /></Panel>
                        <Panel IsVisible="{Binding ShowsRvz}"><v:PresetPicker DataContext="{Binding Settings.Presets.Rvz}" /></Panel>
                        <StackPanel Spacing="4" IsVisible="{Binding ShowsWua}">
                            <v:PresetPicker DataContext="{Binding Settings.Presets.Wua}" />
                            <!-- Encrypted titles and discs need the user's own keys -->
                            <TextBlock Text="WII U KEYS" Classes="section" />
                            <TextBlock Classes="hint" Text="{Binding Settings.Keys.WiiUKeysSummary}" TextWrapping="Wrap" />
                            <WrapPanel Orientation="Horizontal">
                                <Button Classes="tool" Content="Choose keys.txt…" Command="{Binding Settings.Keys.BrowseWiiUKeysCommand}" Margin="0,0,6,6" />
                                <Button Classes="tool" Content="Find automatically" Command="{Binding Settings.Keys.FindWiiUKeysAutomaticallyCommand}" Margin="0,0,6,6" />
                                <Button Classes="tool" Content="Refresh" Command="{Binding Settings.Keys.RefreshWiiUKeysCommand}" Margin="0,0,6,6" />
                            </WrapPanel>
                        </StackPanel>
                        <Panel IsVisible="{Binding ShowsArchives}"><v:PresetPicker DataContext="{Binding Settings.Presets.Archive}" /></Panel>
                        <Panel IsVisible="{Binding ShowsExtract}"><v:PresetPicker DataContext="{Binding Settings.Presets.Extract}" /></Panel>
                        <Panel IsVisible="{Binding ShowsUnpacking}"><v:PresetPicker DataContext="{Binding Settings.Presets.Unpack}" /></Panel>
                    </StackPanel>

                    <Separator Margin="0,10" />
                    <v:RunOptions />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
