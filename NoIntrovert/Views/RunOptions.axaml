<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             x:Class="NoIntrovert.Views.RunOptions"
             x:DataType="vm:BatchTabViewModel">
    <!-- Save to, in the run bar just left of Cancel / Convert: where this page's results go.
         The radio buttons follow the view model, which keeps exactly one of them on. -->
    <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="4" VerticalAlignment="Center">
        <RadioButton Content="Next to the originals" IsChecked="{Binding SaveNextToOriginals}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <RadioButton IsChecked="{Binding SaveInFolder}" VerticalAlignment="Center" ToolTip.Tip="{Binding SaveFolderText}">
                <TextBlock Text="{Binding SaveFolderText, StringFormat='Folder: {0}'}" MaxWidth="200"
                           TextTrimming="LeadingCharacterEllipsis" />
            </RadioButton>
            <TextBlock Text="·" Classes="hint" VerticalAlignment="Center" />
            <Button Classes="tool" Content="Change…" Command="{Binding ChangeSaveFolderCommand}" VerticalAlignment="Center" />
        </StackPanel>
        <RadioButton Content="Replace the originals ⚠" IsChecked="{Binding SaveReplacingOriginals}" VerticalAlignment="Center"
                     ToolTip.Tip="Each original is removed only after its new file verifies. If verification fails, the original stays and the row shows why." />
    </WrapPanel>
</UserControl>
