<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             x:Class="NoIntrovert.Views.RunOptions"
             x:DataType="vm:BatchTabViewModel">
    <!-- Where this tab's results go: the Settings defaults, which can be changed for this tab's runs only. -->
    <StackPanel Spacing="4">
        <TextBlock Text="THIS RUN" Classes="section" Margin="0,0,0,4" />
        <TextBlock Text="Saving to" />
        <TextBlock Classes="hint" Text="{Binding RunFolderText}" TextTrimming="LeadingCharacterEllipsis"
                   ToolTip.Tip="{Binding RunFolderText}" />
        <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
            <Button Classes="tool" Content="Another folder…" Command="{Binding ChooseRunFolderCommand}" Margin="0,0,6,6"
                    ToolTip.Tip="Use a different folder for this tab's runs, without changing the default." />
            <Button Classes="tool" Content="Use the defaults" Command="{Binding ResetRunOptionsCommand}" Margin="0,0,6,6"
                    IsVisible="{Binding HasRunOverrides}" />
        </WrapPanel>
        <CheckBox Content="Overwrite existing files" IsChecked="{Binding RunOverwrite}" />
        <TextBlock Classes="hint" Text="{Binding RunOptionsNote}" TextWrapping="Wrap" />
        <Button Classes="tool" Content="Change the defaults in Settings…" Command="{Binding OpenSettingsCommand}" Margin="0,4,0,0" />
    </StackPanel>
</UserControl>
