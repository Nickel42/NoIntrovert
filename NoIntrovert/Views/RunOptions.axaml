<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             x:Class="NoIntrovert.Views.RunOptions"
             x:DataType="vm:BatchTabViewModel">
    <!-- Save to, in the run bar just left of Cancel / Convert: where this page's results go.
         The radio buttons follow the view model, which keeps exactly one of them on. -->
    <UserControl.Styles>
        <!-- Change…: a bold text link after the folder -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PanelHeadText}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </UserControl.Styles>
    <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="4" VerticalAlignment="Center">
        <RadioButton Content="Next to the originals" IsChecked="{Binding SaveNextToOriginals}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <RadioButton IsChecked="{Binding SaveInFolder}" VerticalAlignment="Center" ToolTip.Tip="{Binding SaveFolderText}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Folder:" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SaveFolderText}" MaxWidth="180" Foreground="{DynamicResource SubtleText}"
                               TextTrimming="LeadingCharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>
            <Button Classes="link" Content="Change…" Command="{Binding ChangeSaveFolderCommand}" VerticalAlignment="Center"
                    ToolTip.Tip="Choose the folder" AutomationProperties.Name="Change the save folder" />
        </StackPanel>
        <!-- How the folder is arranged: its own item, so a narrow run bar puts it on the next line -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding SaveInFolder}">
            <TextBlock Text="Layout:" VerticalAlignment="Center" Foreground="{DynamicResource SubtleText}" />
            <ComboBox x:Name="FolderLayoutPicker" VerticalAlignment="Center" MinHeight="0" Padding="8,2"
                      ItemsSource="{x:Static vm:OutputSettingsViewModel.ShortFolderLayouts}" SelectedItem="{Binding Settings.Output.SelectedShortFolderLayout}"
                      AutomationProperties.Name="Folder layout" ToolTip.Tip="{x:Static vm:OutputSettingsViewModel.FolderLayoutTip}" />
        </StackPanel>
        <RadioButton IsChecked="{Binding SaveReplacingOriginals}" VerticalAlignment="Center"
                     ToolTip.Tip="Each original is removed only after its new file verifies. If verification fails, the original stays and the row shows why.">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Replace the originals" VerticalAlignment="Center" />
                <TextBlock Text="⚠" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" AutomationProperties.Name="Warning: originals are removed" />
            </StackPanel>
        </RadioButton>
    </WrapPanel>
</UserControl>
