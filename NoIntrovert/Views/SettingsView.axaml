<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             xmlns:v="using:NoIntrovert.Views"
             x:Class="NoIntrovert.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <!--
        One scrolling page with no Save button: every change is saved as it's
        made. Two columns of cards (one when the window is narrow, see the
        code-behind), then the Advanced cards, collapsed and quieter: the
        presets' details, targets, databases, keys and diagnostics.
    -->
    <UserControl.Styles>
        <Style Selector="TextBlock.overridden">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- Advanced cards: no fill, so the main ones stand out -->
        <Style Selector="Border.card.quiet">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Margin="0,10,0,0">
        <StackPanel Margin="0,0,12,0">
            <TextBlock Margin="0,0,0,12">
                <Run Text="Settings" FontSize="20" FontWeight="SemiBold" />
                <Run Text=" · Changes are saved as you make them" FontSize="13" Foreground="{DynamicResource SubtleText}" />
            </TextBlock>

            <Grid x:Name="MainColumns" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0">

                    <!-- General -->
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="GENERAL" Classes="section" Margin="0,0,0,4" />
                            <Grid ColumnDefinitions="*,200" ColumnSpacing="8">
                                <TextBlock Text="Theme" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:GeneralSettingsViewModel.Themes}"
                                          SelectedItem="{Binding General.SelectedTheme}" HorizontalAlignment="Stretch" />
                            </Grid>
                            <Grid ColumnDefinitions="*,200" ColumnSpacing="8">
                                <TextBlock Text="Start on" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding General.StartPages}"
                                          SelectedItem="{Binding General.SelectedStartPage}" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="The page the app opens on. Automatic: Optimize once the library has folders, otherwise Convert." />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Output -->
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="OUTPUT" Classes="section" Margin="0,0,0,4" />
                            <Grid ColumnDefinitions="*,200" ColumnSpacing="8">
                                <TextBlock Text="Save to" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:OutputSettingsViewModel.SaveToChoices}"
                                          SelectedItem="{Binding Output.SelectedSaveTo}" HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBlock Classes="hint" Text="The run bar starts with this choice." />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Output.SavesToFolder}">
                                <TextBlock Classes="hint" Text="{Binding Output.SaveFolderText}" VerticalAlignment="Center"
                                           TextWrapping="NoWrap" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Output.SaveFolderText}" />
                                <Button Grid.Column="1" Classes="tool" Content="Choose folder…" Command="{Binding Output.BrowseFolderCommand}" />
                            </Grid>
                            <TextBlock Classes="hint" IsVisible="{Binding Output.ReplacesOriginals}"
                                       Text="⚠ Each original is removed once its new file checks out." />
                            <CheckBox Content="Overwrite existing files" IsChecked="{Binding Output.Overwrite}" Margin="0,4,0,0" />
                            <TextBlock Classes="hint" Text="Off: a taken name gets &quot; (2)&quot;." />
                            <TextBlock Text="Working folder for unpacking" Margin="0,6,0,0" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Classes="hint" Text="{Binding Performance.TempFolderHint}" VerticalAlignment="Center"
                                           TextWrapping="NoWrap" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Performance.TempFolderHint}" />
                                <Button Grid.Column="1" Classes="tool" Content="Choose…" Command="{Binding Performance.BrowseTempFolderCommand}" />
                                <Button Grid.Column="2" Classes="tool" Content="Default" Command="{Binding Performance.UseDefaultTempFolderCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Performance -->
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="PERFORMANCE" Classes="section" Margin="0,0,0,4" />
                            <Grid ColumnDefinitions="*,200" ColumnSpacing="8">
                                <TextBlock Text="Jobs at once" VerticalAlignment="Center"
                                           ToolTip.Tip="How many jobs the queue runs at the same time, across every page." />
                                <NumericUpDown Grid.Column="1" Value="{Binding Performance.ParallelJobs}" Minimum="1" Maximum="{Binding Performance.MaxThreads}"
                                               Increment="1" FormatString="0" />
                            </Grid>
                            <CheckBox Content="Check each file after converting" IsChecked="{Binding Chd.VerifyAfterCreate}" Margin="0,4,0,0" />
                            <TextBlock Classes="hint" Text="CHD and RVZ files. Always on when replacing the originals." />
                        </StackPanel>
                    </Border>

                    <!-- Log -->
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="LOG" Classes="section" Margin="0,0,0,4" />
                            <CheckBox Content="Open the log when a run has errors" IsChecked="{Binding Log.OpenLogOnErrors}" />
                            <Grid ColumnDefinitions="*,120,Auto" ColumnSpacing="8">
                                <TextBlock Text="Keep logs for" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding Log.KeepLogsDays}" Minimum="1" Maximum="365" Increment="1" FormatString="0" />
                                <TextBlock Grid.Column="2" Text="days" VerticalAlignment="Center" />
                            </Grid>
                            <Button Classes="tool" Content="Open log folder" Command="{Binding Log.OpenLogFolderCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">

                    <!-- Default presets: filled in by the presets work -->
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="DEFAULT PRESETS" Classes="section" Margin="0,0,0,4" />
                            <ContentControl Content="{Binding DefaultPresets}" />
                            <TextBlock Classes="hint" Text="Choose a preset for each system on the Convert page."
                                       IsVisible="{Binding DefaultPresets, Converter={x:Static ObjectConverters.IsNull}}" />
                        </StackPanel>
                    </Border>

                    <!-- Library -->
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="LIBRARY" Classes="section" Margin="0,0,0,4" />
                            <TextBlock Text="Folders Optimize scans" />
                            <ItemsControl ItemsSource="{Binding Library.Folders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding}" Classes="hint" VerticalAlignment="Center" TextWrapping="NoWrap"
                                                       TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding}" />
                                            <Button Grid.Column="1" Classes="tool" Content="Remove" ToolTip.Tip="Stop scanning this folder (no files are touched)."
                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).Library.RemoveFolderFromListCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="hint" Text="No folders yet." IsVisible="{Binding !Library.HasFolders}" />
                            <Button Classes="tool" Content="Add folder…" Command="{Binding Library.AddFolderCommand}" HorizontalAlignment="Left" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                                <TextBlock Classes="hint" Text="{Binding Library.EmulatorDataStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Classes="tool" Content="Check now" Command="{Binding Library.CheckEmulatorDataCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- About -->
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="ABOUT" Classes="section" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding About.Version}" />
                            <TextBlock Classes="hint" Text="{Binding About.ToolVersions}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <HyperlinkButton Content="Check for updates" Padding="0,2"
                                                 NavigateUri="https://github.com/Nickel42/NoIntrovert/releases"
                                                 ToolTip.Tip="Opens the releases page in your browser" />
                                <HyperlinkButton Content="Licenses" Padding="0,2"
                                                 NavigateUri="https://github.com/Nickel42/NoIntrovert#license"
                                                 ToolTip.Tip="NoIntrovert's licence and the bundled libraries' (opens in your browser)" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Advanced: everything else, collapsed -->
            <Expander Header="Advanced" Margin="0,4,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Classes="hint" Text="Fine-tuning most people never need." />
                    <Grid x:Name="AdvancedColumns" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0">

                            <!-- Power-user mode -->
                            <Border Classes="card quiet">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="POWER USER" Classes="section" Margin="0,0,0,4" />
                                    <CheckBox Content="Power-user mode" IsChecked="{Binding General.PowerUserMode}" />
                                    <TextBlock Classes="hint"
                                               Text="Shows Expert options (hunk size, threads, block sizes), lib-chd-kit's own log messages, the Diagnostics card and the Library tests page." />
                                </StackPanel>
                            </Border>

                            <!-- Presets (issue #33): how each action is done; parameters only under Custom -->
                            <Border Classes="card quiet" DataContext="{Binding Presets}" x:DataType="vm:PresetsViewModel">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="HOW EACH ACTION IS DONE" Classes="section" Margin="0,0,0,4" />
                                    <TextBlock Classes="hint"
                                               Text="The recommended preset suits most libraries; choose Custom to set the details yourself. The Convert and Verify pages show the same choices." />
                                    <ItemsControl ItemsSource="{Binding All}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ActionPresetViewModel">
                                                <v:PresetPicker />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Default targets: what a GameCube/Wii disc and a new archive become -->
                            <Border Classes="card quiet">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="DEFAULT TARGETS" Classes="section" Margin="0,0,0,4" />
                                    <TextBlock Text="GameCube and Wii discs become" />
                                    <ComboBox ItemsSource="{x:Static vm:NintendoSettingsViewModel.Targets}" SelectedItem="{Binding Nintendo.SelectedTarget}"
                                              HorizontalAlignment="Stretch" />
                                    <TextBlock Text="New archives are" Margin="0,4,0,0" />
                                    <ComboBox ItemsSource="{x:Static vm:ArchiveSettingsViewModel.Formats}" SelectedItem="{Binding Archives.SelectedFormat}"
                                              HorizontalAlignment="Stretch" />
                                    <TextBlock Classes="hint" Text="Each row on the Convert page can still choose its own target." />
                                </StackPanel>
                            </Border>

                            <!-- Files and the library's scans -->
                            <Border Classes="card quiet">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="FILES AND FOLDERS" Classes="section" Margin="0,0,0,4" />
                                    <CheckBox Content="Include subfolders when adding a folder" IsChecked="{Binding Output.ScanSubfolders}" />
                                    <CheckBox Content="{Binding Output.RecycleBinLabel}" IsChecked="{Binding Output.UseRecycleBin}" IsVisible="{Binding Output.CanUseRecycleBin}"
                                              ToolTip.Tip="When the originals are replaced, or a preset removes them once the new file checks out." />
                                    <CheckBox Content="Scan the library folders when the app starts" IsChecked="{Binding Library.RescanOnStart}"
                                              ToolTip.Tip="Only files that changed since the last scan are read again." />
                                    <TextBlock Text="Organize puts games in" Margin="0,4,0,0" />
                                    <ComboBox ItemsSource="{x:Static vm:LibrarySettingsViewModel.Layouts}" SelectedItem="{Binding Library.SelectedLayout}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>

                            <!-- Keys -->
                            <Border Classes="card quiet" DataContext="{Binding Keys}" x:DataType="vm:KeySettingsViewModel">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="KEYS" Classes="section" Margin="0,0,0,4" />
                                    <TextBlock Classes="hint"
                                               Text="Encrypted Wii U titles and discs need your own keys.txt (the one Cemu uses). NoIntrovert doesn't include any keys." />
                                    <TextBlock Classes="hint" Text="{Binding WiiUKeysSummary}" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="tool" Content="Choose keys.txt…" Command="{Binding BrowseWiiUKeysCommand}" Margin="0,0,6,6" />
                                        <Button Classes="tool" Content="Find automatically" Command="{Binding FindWiiUKeysAutomaticallyCommand}" Margin="0,0,6,6" />
                                        <Button Classes="tool" Content="Refresh" Command="{Binding RefreshWiiUKeysCommand}" Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1">

                            <!-- Game databases (M6) and ES-DE's system list -->
                            <Border Classes="card quiet" DataContext="{Binding Dats}" x:DataType="vm:DatSettingsViewModel">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="GAME DATABASES" Classes="section" Margin="0,0,0,4" />
                                    <TextBlock Classes="hint"
                                               Text="Verify looks games up in the No-Intro and Redump databases. NoIntrovert downloads them from libretro-database, only for the systems in your library." />
                                    <TextBlock Classes="hint" Text="{Binding Status}" />
                                    <Button Classes="tool" Content="Update now" Command="{Binding UpdateNowCommand}" HorizontalAlignment="Left" />
                                    <TextBlock Classes="hint" Text="{Binding EsdeStatus}" Margin="0,6,0,0"
                                               ToolTip.Tip="Organize's ES-DE layout uses ES-DE's own system folder names, from its latest release on GitLab." />
                                    <Button Classes="tool" Content="Check now" Command="{Binding CheckEsdeNowCommand}" HorizontalAlignment="Left" />
                                    <CheckBox Content="Check for newer databases when the app starts" IsChecked="{Binding CheckOnStart}"
                                              ToolTip.Tip="Small requests to GitHub and GitLab, in the background; only changed databases are downloaded, and ES-DE's system list at most once a day." />
                                    <TextBlock Text="Your own DAT files" Margin="0,6,0,0" />
                                    <TextBlock Classes="hint"
                                               Text="A folder of .dat files (ClrMamePro or Logiqx XML, such as a No-Intro daily pack). One with the same name as a downloaded database is used instead of it." />
                                    <TextBlock Classes="hint" Text="{Binding OwnFolderText}" TextWrapping="NoWrap" TextTrimming="LeadingCharacterEllipsis"
                                               ToolTip.Tip="{Binding OwnFolderText}" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="tool" Content="Choose folder…" Command="{Binding BrowseOwnFolderCommand}" Margin="0,0,6,6" />
                                        <Button Classes="tool" Content="None" Command="{Binding ClearOwnFolderCommand}" Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Target formats (docs/target-formats.md) -->
                            <Border Classes="card quiet" DataContext="{Binding TargetFormats}" x:DataType="vm:TargetFormatSettingsViewModel">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="TARGET FORMATS" Classes="section" Margin="0,0,0,4" />
                                    <TextBlock Classes="hint"
                                               Text="Each system has a recommended format and container: cartridge ROMs in a single-file 7z, discs as bare CHD, RVZ or WUA, computer games in zip, arcade romsets left as they are." />
                                    <HyperlinkButton Content="Read the target formats guide" Padding="0,2"
                                                     NavigateUri="https://github.com/Nickel42/NoIntrovert/blob/main/docs/target-formats.md"
                                                     ToolTip.Tip="What each system's target is, and why (opens in your browser)" />
                                    <TextBlock Classes="hint" Text="{Binding OverrideSummary}" />

                                    <!-- Systems grid: your choice per system -->
                                    <TextBlock Text="BY SYSTEM" Classes="section" />
                                    <TextBox Text="{Binding Filter}" PlaceholderText="Filter by system or extension…" />
                                    <ScrollViewer MaxHeight="360">
                                        <ItemsControl ItemsSource="{Binding Systems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SystemTargetRow">
                                                    <Grid ColumnDefinitions="*,150,64" ColumnSpacing="6" Margin="0,0,6,6">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Classes.overridden="{Binding IsOverridden}" />
                                                            <TextBlock Text="{Binding Recommended}" Classes="hint" FontSize="11" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Choice}" HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center" ToolTip.Tip="{Binding Choice}">
                                                            <ComboBox.Styles>
                                                                <Style Selector="ComboBoxItem">
                                                                    <Setter Property="IsEnabled" Value="{ReflectionBinding Producible}" />
                                                                </Style>
                                                            </ComboBox.Styles>
                                                        </ComboBox>
                                                        <Button Grid.Column="2" Classes="tool" Content="Reset" Command="{Binding ResetCommand}" VerticalAlignment="Center"
                                                                HorizontalAlignment="Stretch" IsVisible="{Binding IsOverridden}" ToolTip.Tip="Back to the recommended target" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- File-type rules -->
                                    <TextBlock Text="BY FILE TYPE" Classes="section" />
                                    <TextBlock Classes="hint" Text="A file type within a system wins over the system's choice, which wins over a file type for every system." />
                                    <ItemsControl ItemsSource="{Binding Rules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ExtensionRuleRow">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <Button Grid.Column="1" Classes="tool" Content="Remove" VerticalAlignment="Center"
                                                            Command="{Binding $parent[ItemsControl].((vm:TargetFormatSettingsViewModel)DataContext).RemoveRuleCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*,70" ColumnSpacing="6">
                                        <ComboBox ItemsSource="{Binding RuleSystems}" SelectedItem="{Binding NewRuleSystem}" HorizontalAlignment="Stretch" />
                                        <TextBox Grid.Column="1" Text="{Binding NewRuleExtension}" PlaceholderText=".nds" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <ComboBox ItemsSource="{Binding RuleTargets}" SelectedItem="{Binding NewRuleTarget}" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Classes="tool" Content="Add rule" Command="{Binding AddRuleCommand}" />
                                    </Grid>

                                    <!-- The rules' options -->
                                    <TextBlock Text="RULE OPTIONS" Classes="section" />
                                    <TextBlock Text="Folder for the discs of multi-disc games" />
                                    <TextBox Text="{Binding MultiDiscFolder}" />
                                    <CheckBox Content="Fix byte order and copier headers (.v64 → .z64, …)" IsChecked="{Binding NormalizeHeaders}" />
                                    <CheckBox Content="Keep the original hashes of converted files" IsChecked="{Binding RecordOriginalHashes}"
                                              ToolTip.Tip="So a CHD, RVZ or NSZ can still be checked against No-Intro and Redump" />
                                    <CheckBox Content="Write a PS Vita launcher file next to each game" IsChecked="{Binding WriteVitaLauncher}" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding WriteVitaLauncher}">
                                        <TextBlock Text="Its extension" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding VitaLauncherExtension}" />
                                    </Grid>
                                    <StackPanel Spacing="4" IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).General.PowerUserMode}">
                                        <TextBlock Text="EXPERT" Classes="section" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <TextBlock Text="Keep Nintendo DS ROMs bigger than this bare (MB, 0 = off)" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Column="1" Value="{Binding DsBareAboveMb}" Minimum="0" Maximum="1024" Increment="64" FormatString="0" Width="130" />
                                        </Grid>
                                    </StackPanel>

                                    <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Classes="tool" Content="Reset all" Command="{Binding ResetAllCommand}" Margin="0,0,6,6" />
                                        <Button Classes="tool" Content="Export overrides…" Command="{Binding ExportCommand}" Margin="0,0,6,6" />
                                        <Button Classes="tool" Content="Import overrides…" Command="{Binding ImportCommand}" Margin="0,0,6,6" />
                                    </WrapPanel>
                                    <TextBlock Classes="hint" Text="{Binding TransferNote}" />
                                    <TextBlock Classes="hint" Text="Changes apply to new rows on the Convert page, and to the library at its next scan." />
                                </StackPanel>
                            </Border>

                            <!-- Diagnostics: Power-user mode only -->
                            <Border Classes="card quiet" IsVisible="{Binding General.PowerUserMode}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="DIAGNOSTICS" Classes="section" Margin="0,0,0,4" />
                                    <CheckBox Content="Log lib-chd-kit's messages" IsChecked="{Binding General.VerboseLog}"
                                              ToolTip.Tip="Every message lib-chd-kit sends, shown as debug lines." />
                                    <CheckBox Content="Log progress every 10%" IsChecked="{Binding General.LogProgress}" />
                                    <Grid ColumnDefinitions="*,110" ColumnSpacing="8" Margin="0,4,0,0">
                                        <TextBlock Text="Threads per job (0 = all)" VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Column="1" Value="{Binding Performance.ThreadsPerJob}" Minimum="0" Maximum="{Binding Performance.MaxThreads}"
                                                       Increment="1" FormatString="0" />
                                    </Grid>
                                    <TextBlock Classes="hint" Margin="0,6,0,0"
                                               Text="The Library tests page (in the rail) compares lib-chd-kit with chdman and round-trips discs." />
                                    <TextBlock Text="chdman executable (for the Library tests' comparison)" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TextBox Text="{Binding Diagnostics.ChdmanExePath}" PlaceholderText="Path to chdman" />
                                        <Button Grid.Column="1" Classes="tool" Content="Browse…" Command="{Binding Diagnostics.BrowseChdmanExeCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
