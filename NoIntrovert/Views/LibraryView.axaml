<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             xmlns:v="using:NoIntrovert.Views"
             xmlns:core="using:NoIntrovert.Core"
             x:Class="NoIntrovert.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             v:Responsive.Below="compact:1000,narrow:720">
    <!--
        The Library: the folders it watches, every game found in them, and the
        selected game's files. The game list is virtualised, so a library of
        thousands of games costs only the rows on screen.
    -->
    <UserControl.Styles>
        <!-- Column widths, shared by the headings and the rows. Narrower pages drop Formats, then System,
             and give the details panel less room; the game's title takes what's left. -->
        <Style Selector=":is(Control).col-system"><Setter Property="Width" Value="130" /></Style>
        <Style Selector=":is(Control).col-formats"><Setter Property="Width" Value="100" /></Style>
        <Style Selector=":is(Control).col-size"><Setter Property="Width" Value="76" /></Style>
        <Style Selector=":is(Control).col-status"><Setter Property="Width" Value="150" /></Style>
        <Style Selector="ScrollViewer.details"><Setter Property="Width" Value="340" /></Style>
        <Style Selector="ComboBox.systems"><Setter Property="Width" Value="170" /></Style>
        <Style Selector="ComboBox.statuses"><Setter Property="Width" Value="200" /></Style>

        <Style Selector="v|LibraryView.compact :is(Control).col-formats"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="v|LibraryView.compact :is(Control).col-system"><Setter Property="Width" Value="120" /></Style>
        <Style Selector="v|LibraryView.compact :is(Control).col-status"><Setter Property="Width" Value="140" /></Style>
        <Style Selector="v|LibraryView.compact ScrollViewer.details"><Setter Property="Width" Value="280" /></Style>
        <Style Selector="v|LibraryView.compact ComboBox.systems"><Setter Property="Width" Value="140" /></Style>
        <Style Selector="v|LibraryView.compact ComboBox.statuses"><Setter Property="Width" Value="160" /></Style>

        <Style Selector="v|LibraryView.narrow :is(Control).col-system"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="v|LibraryView.narrow ScrollViewer.details"><Setter Property="Width" Value="240" /></Style>

        <!-- Column headings: a click sorts by the column (▲ ascending, ▼ descending). Plain text, not a boxed button. -->
        <Style Selector="Button.colsort">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.colsort TextBlock.arrow"><Setter Property="FontSize" Value="9" /></Style>
        <Style Selector="Button.colsort.sorted TextBlock.colhead"><Setter Property="Foreground" Value="{DynamicResource SukiText}" /></Style>
        <Style Selector="Button.colsort:pointerover TextBlock.colhead"><Setter Property="Foreground" Value="{DynamicResource SukiText}" /></Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,10,0,0">
        <Border Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

                <!-- Folders -->
                <Grid ColumnDefinitions="Auto,*" Margin="12,10,12,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="tool" Content="Add folder…" Command="{Binding AddFolderCommand}"
                                ToolTip.Tip="Add a folder where you keep games (Ctrl+O)." />
                        <Button Classes="tool" Content="Rescan" Command="{Binding RescanCommand}" IsEnabled="{Binding !IsScanning}"
                                ToolTip.Tip="Look through the folders again (F5). Files that haven't changed aren't reread." />
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Folders}" Margin="10,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <!-- A long path trims from the left to the room there is -->
                                <Border Background="{DynamicResource RowAlt}" CornerRadius="12" Padding="10,2,4,2" Margin="0,0,6,4">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="tool" Content="✕" Padding="6,0" FontSize="11" Margin="4,0,0,0"
                                                ToolTip.Tip="Stop keeping track of this folder (no files are touched)."
                                                AutomationProperties.Name="{Binding StringFormat='Remove folder {0}'}"
                                                Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).RemoveFolderCommand}" CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12" MaxWidth="320" TextTrimming="LeadingCharacterEllipsis"
                                                   ToolTip.Tip="{Binding}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Filters -->
                <!-- Filters, then what they show (or the scan's progress) on a line of its own -->
                <StackPanel Grid.Row="1" Margin="12,4,12,4" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox x:Name="SearchBox" Text="{Binding Search, Delay=250}" PlaceholderText="Search games…" MinWidth="120"
                                 AutomationProperties.Name="Search games" ToolTip.Tip="Search by title (Ctrl+F; Escape clears it)." />
                        <ComboBox Grid.Column="1" Classes="systems" ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}"
                                  AutomationProperties.Name="Filter by system" />
                        <ComboBox Grid.Column="2" Classes="statuses" ItemsSource="{x:Static vm:LibraryViewModel.StatusFilters}" SelectedItem="{Binding SelectedStatus}"
                                  AutomationProperties.Name="Filter by status" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="22">
                        <TextBlock Text="{Binding Summary}" Classes="hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Summary}"
                                   IsVisible="{Binding !IsScanning}" />
                        <DockPanel IsVisible="{Binding IsScanning}">
                            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="80" Height="6" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ScanStatus}" Classes="hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Button Grid.Column="1" Classes="tool" Content="Stop" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}" Margin="8,0,0,0"
                                ToolTip.Tip="Stop the scan (Escape)." />
                    </Grid>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="{Binding MissingNote}" Classes="hint" Margin="12,0,12,4" TextWrapping="Wrap"
                           Foreground="{x:Static v:Palette.Warn}"
                           IsVisible="{Binding MissingNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Column headings -->
                <!-- Its left and right edges follow the rows' (LibraryView.axaml.cs), so it lines up with or without a scrollbar. -->
                <Grid x:Name="Headings" Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="22,4,22,4">
                    <Button Classes="colsort" HorizontalContentAlignment="Left"
                            Classes.sorted="{Binding GameArrow, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static core:LibrarySortColumn.Game}"
                            ToolTip.Tip="Sort by game; click again to turn the order round">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="GAME" Classes="colhead" />
                            <TextBlock Text="{Binding GameArrow}" Classes="colhead arrow" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="colsort col-system" HorizontalContentAlignment="Left"
                            Classes.sorted="{Binding SystemArrow, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static core:LibrarySortColumn.System}"
                            ToolTip.Tip="Sort by system; click again to turn the order round">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="SYSTEM" Classes="colhead" />
                            <TextBlock Text="{Binding SystemArrow}" Classes="colhead arrow" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="colsort col-formats" HorizontalContentAlignment="Left"
                            Classes.sorted="{Binding FormatsArrow, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static core:LibrarySortColumn.Formats}"
                            ToolTip.Tip="Sort by formats; click again to turn the order round">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="FORMATS" Classes="colhead" />
                            <TextBlock Text="{Binding FormatsArrow}" Classes="colhead arrow" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Classes="colsort col-size" HorizontalContentAlignment="Right" Padding="0,0,10,0"
                            Classes.sorted="{Binding SizeArrow, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static core:LibrarySortColumn.Size}"
                            ToolTip.Tip="Sort by size; click again to turn the order round">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="SIZE" Classes="colhead" />
                            <TextBlock Text="{Binding SizeArrow}" Classes="colhead arrow" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Classes="colsort col-status" HorizontalContentAlignment="Left"
                            Classes.sorted="{Binding StatusArrow, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static core:LibrarySortColumn.Status}"
                            ToolTip.Tip="Sort by status; click again to turn the order round">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="STATUS" Classes="colhead" />
                            <TextBlock Text="{Binding StatusArrow}" Classes="colhead arrow" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Games -->
                <Panel Grid.Row="4">
                    <!-- The list hands its SelectedItems to the page in code (LibraryView.axaml.cs) -->
                    <ListBox x:Name="GameList" ItemsSource="{Binding VisibleGames}" SelectionMode="Multiple" SelectedItem="{Binding SelectedGame}"
                             Background="Transparent" Margin="10,0" AutomationProperties.Name="Games">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="12,5" />
                                <Setter Property="CornerRadius" Value="4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameRowViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                        <TextBlock Text="{Binding DiscsText}" Classes="hint" FontSize="11"
                                                   IsVisible="{Binding DiscsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Classes="col-system" Text="{Binding System}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding System}" Padding="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Classes="hint col-formats" Text="{Binding Formats}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Padding="0,0,8,0" />
                                    <TextBlock Grid.Column="3" Classes="col-size" Text="{Binding SizeText}" VerticalAlignment="Center" TextAlignment="Right" Padding="0,0,10,0" />
                                    <DockPanel Grid.Column="4" Classes="col-status" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding Status, Converter={x:Static v:Palette.GameStatusBrush}}" />
                                        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}" />
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel IsVisible="{Binding ShowsEmptyMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="520">
                        <TextBlock Text="Add the folders where you keep your games." FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Classes="hint" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="NoIntrovert looks through them (subfolders too), groups the files into games by title and system, and shows what still needs converting. Nothing is changed until you convert. You can also drop folders here." />
                        <Button Classes="primary" Content="Add folder…" Command="{Binding AddFolderCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Panel>

                <!-- Actions on the selected games -->
                <Border Grid.Row="5" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="12,10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <!-- Why the last action did nothing (it's in the log too, which may be closed) -->
                    <TextBlock Text="{Binding ActionNote}" Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding ActionNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="8">
                        <Button Content="Clean up selected" Command="{Binding CleanupSelectedCommand}"
                                ToolTip.Tip="Plan converting, renaming, moving and removing duplicates for the selected games, as a dry run first." />
                        <Button Content="Verify selected" Command="{Binding VerifySelectedCommand}"
                                ToolTip.Tip="Send the selected games to Verify &amp; match, to check them for damage and against the No-Intro and Redump databases." />
                        <Button Classes="primary" Content="Convert selected" Command="{Binding ConvertSelectedCommand}"
                                ToolTip.Tip="Send what still needs converting in the selected games to the Convert page (Enter in the list)." />
                    </WrapPanel>
                  </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Details of the selected game -->
        <ScrollViewer Grid.Column="1" Classes="details" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
            <Border Classes="card" IsVisible="{Binding SelectedGame, Converter={x:Static ObjectConverters.IsNotNull}}">
                <v:SelectedFilePanel DataContext="{Binding SelectedFile}" />
            </Border>
            <Border Classes="card">
                <Panel>
                    <TextBlock Text="Select a game to see its files." Classes="hint" IsVisible="{Binding SelectedGame, Converter={x:Static ObjectConverters.IsNull}}" />
                    <StackPanel Spacing="6" DataContext="{Binding SelectedGame}" x:DataType="vm:GameRowViewModel"
                                IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).SelectedGame, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="DETAILS" Classes="section" />
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="hint">
                            <Run Text="{Binding System}" /><Run Text=" · " /><Run Text="{Binding SizeText}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={x:Static v:Palette.GameStatusBrush}}" />
                            <TextBlock Text="{Binding StatusText}" />
                        </StackPanel>

                        <TextBlock Text="{Binding MatchSummary}" Classes="hint" TextWrapping="Wrap" />

                        <TextBlock Text="FILES" Classes="section" />
                        <ItemsControl ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameFileRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                            <TextBlock Classes="hint" FontSize="11">
                                                <Run Text="{Binding Format}" /><Run Text=" · " /><Run Text="{Binding Size}" /><Run Text=" " /><Run Text="{Binding Disc}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Match}" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasMatch}" />
                                            <TextBlock Text="{Binding FormatStatus}" FontSize="11" TextWrapping="Wrap"
                                                       ToolTip.Tip="Where this file stands against its system's target format (see Settings → Target formats guide)." />
                                            <TextBlock Text="{Binding Folder}" Classes="hint" FontSize="11" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Folder}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="tool" Content="Show" VerticalAlignment="Top" ToolTip.Tip="Open its folder"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Show {0} in its folder'}"
                                                Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ShowInFolderCommand}" CommandParameter="{Binding Path}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The first CHD's header, from lib-chd-kit -->
                        <StackPanel Spacing="4" IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ShowsChdInfo}">
                            <TextBlock Text="CHD" Classes="section" />
                            <TextBlock Text="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ChdInfo.Headline}" Classes="hint" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ChdInfo.Properties}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InfoRow">
                                        <Grid ColumnDefinitions="110,*" Margin="0,1">
                                            <TextBlock Text="{Binding Name}" Classes="hint" FontSize="12" />
                                            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Panel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
