<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:suki="https://github.com/kikipoulet/SukiUI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NoIntrovert.ViewModels"
        xmlns:core="using:NoIntrovert.Core"
        xmlns:v="using:NoIntrovert.Views"
        x:Class="NoIntrovert.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/nointrovert.ico"
        Title="NoIntrovert"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource AppBackground}"
        BackgroundStyle="Flat" BackgroundAnimationEnabled="False" BackgroundTransitionsEnabled="False"
        ShowTitlebarBackground="False" ShowBottomBorder="False"
        TitleFontSize="14" TitleFontWeight="Bold" TitleBarControlSize="12"
        DragDrop.AllowDrop="True">

    <!-- The design's title bar: the app icon and name at the left; the theme toggle, minimize, maximize and close at the right. -->
    <suki:SukiWindow.LogoContent>
        <Border Width="24" Height="24" CornerRadius="6" ClipToBounds="True">
            <Image Source="/Assets/nointrovert-64.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Border>
    </suki:SukiWindow.LogoContent>
    <suki:SukiWindow.RightWindowTitleBarControls>
        <Button x:Name="ThemeToggle" Classes="WindowControlsButton themetoggle" Click="OnThemeToggleClick"
                ToolTip.Tip="{DynamicResource ThemeToggleTip}">
            <Path Data="{DynamicResource ThemeToggleIcon}" Width="16" Height="16" Stretch="Uniform"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
        </Button>
    </suki:SukiWindow.RightWindowTitleBarControls>

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <!-- The toggle shows the moon on the dark theme and the sun on the light one, as in the design. -->
            <ResourceDictionary x:Key="Dark">
                <StreamGeometry x:Key="ThemeToggleIcon">M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z</StreamGeometry>
                <x:String x:Key="ThemeToggleTip">Switch to the light theme</x:String>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <StreamGeometry x:Key="ThemeToggleIcon">M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4</StreamGeometry>
                <x:String x:Key="ThemeToggleTip">Switch to the dark theme</x:String>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <!-- One rail button: icon, title, and an optional line of small text under the title -->
        <DataTemplate x:Key="RailButton" x:DataType="vm:PageViewModel">
            <Button Classes="rail" Classes.selected="{Binding IsSelected}" Classes.featured="{Binding HasSubtitle}" IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding Title}"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectPageCommand}" CommandParameter="{Binding}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Margin="0,0,0,4">
                <Grid ColumnDefinitions="Auto,*" Margin="0,10">
                    <Path Data="{Binding Icon, Converter={x:Static v:Palette.Geometry}}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Top"
                          StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Classes="railicon" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Classes="railtext">
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource SubtleText}" TextWrapping="Wrap" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <!-- Title bar: the rail's colour, with round 28 px window buttons; close is red on a red tint. -->
        <Style Selector="Button.WindowControlsButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource WindowButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>
        <Style Selector="Button.WindowControlsButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource PrimaryTint}" />
        </Style>
        <Style Selector="Button.WindowControlsButton.Close">
            <Setter Property="Background" Value="{DynamicResource DangerTint}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
        </Style>
        <Style Selector="Button.WindowControlsButton.Close:pointerover">
            <Setter Property="Background" Value="#E02B27" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.WindowControlsButton.themetoggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style Selector="Button.WindowControlsButton.themetoggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource WindowButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>

        <!-- The log's counts turn red once there's an error, so it's noticed while the log is collapsed -->
        <Style Selector="TextBlock.counts">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="TextBlock.counts.error">
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
        </Style>
        <Style Selector="TextBlock.railsection">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SectionText}" />
            <Setter Property="Margin" Value="12,8,0,4" />
        </Style>

        <!-- Rail icons are muted, white on the selected page's lilac pill -->
        <Style Selector="Path.railicon">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Stroke" Value="{DynamicResource SubtleText}" />
        </Style>
        <Style Selector="Button.rail.selected Path.railicon">
            <Setter Property="Stroke" Value="White" />
        </Style>
        <!-- A page with a line of small text under its name (Optimize) sits on a card of its own -->
        <Style Selector="Button.rail.featured:not(.selected) /template/ Border">
            <Setter Property="Background" Value="{DynamicResource RowAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTint}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.rail.featured:not(.selected):pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryTint}" />
        </Style>
        <Style Selector="Border.railpane">
            <Setter Property="Width" Value="190" />
            <Setter Property="Padding" Value="10,14" />
        </Style>
        <Style Selector="Image.logo">
            <Setter Property="Width" Value="170" />
        </Style>

        <!-- A small window (under 1100 px): the rail shows only icons, each named in its tooltip, and the logo shrinks -->
        <Style Selector="Grid.shell.compact Border.railpane">
            <Setter Property="Width" Value="64" />
            <Setter Property="Padding" Value="8,14" />
        </Style>
        <Style Selector="Grid.shell.compact Image.logo">
            <Setter Property="Width" Value="46" />
        </Style>
        <Style Selector="Grid.shell.compact StackPanel.railtext">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.shell.compact Path.railicon">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Grid.shell.compact Button.rail">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- The section names give way to a small gap -->
        <Style Selector="Grid.shell.compact TextBlock.railsection">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Height" Value="8" />
        </Style>

        <Style Selector="Border.statusbar TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Styles>

    <!-- Navigation rail | the page with the log and queue under it; the status bar spans the bottom. -->
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto" Classes="shell" v:Responsive.Below="compact:1100" Background="{DynamicResource AppBackground}">

        <!-- Navigation rail: the logo, then LIBRARY and FILES, with Settings at the bottom below a divider -->
        <Border Grid.Column="0" Classes="railpane" Background="{DynamicResource HeaderBackground}">
            <DockPanel>
                <Image DockPanel.Dock="Top" Classes="logo" Source="/Assets/nointrovert-logo.png" Stretch="Uniform" Margin="0,0,0,10"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="{DynamicResource PrimaryTint}" Margin="0,4,0,10" />
                    <ItemsControl ItemsSource="{Binding BottomPages}" ItemTemplate="{StaticResource RailButton}" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="LIBRARY" Classes="railsection" />
                        <ItemsControl ItemsSource="{Binding LibraryPages}" ItemTemplate="{StaticResource RailButton}" />
                        <TextBlock Text="FILES" Classes="railsection" Margin="12,14,0,4" />
                        <ItemsControl ItemsSource="{Binding FilePages}" ItemTemplate="{StaticResource RailButton}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- The page, then the log and the queue drawer. The log row is Auto while collapsed to its bar
             (the page takes the height) and a resizable 230 px when expanded; see MainWindow.axaml.cs. -->
        <Grid Grid.Column="1" x:Name="BodyGrid" RowDefinitions="*,Auto,Auto,Auto">
            <ContentControl Grid.Row="0" Content="{Binding SelectedPage.Content}" Margin="12,6,12,0" />

            <GridSplitter Grid.Row="1" Height="6" Background="Transparent" ResizeDirection="Rows" IsVisible="{Binding Log.IsExpanded}" />
            <Border Grid.Row="1" Height="6" IsVisible="{Binding !Log.IsExpanded}" />

            <!-- Log -->
            <Border Grid.Row="2" Classes="card" Margin="12,0,12,12" Padding="0" x:Name="LogCard">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Log" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Classes="hint counts" Classes.error="{Binding Log.HasErrors}" VerticalAlignment="Center">
                                <Run Text="{Binding Log.ErrorCount}" /><Run Text=" errors · " /><Run Text="{Binding Log.WarningCount}" /><Run Text=" warnings" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Log.IsExpanded}">
                            <CheckBox Content="Show debug" IsChecked="{Binding Log.ShowDebug}" />
                            <CheckBox Content="lib-chd-kit messages" IsChecked="{Binding Settings.General.VerboseLog}" IsVisible="{Binding Settings.General.PowerUserMode}"
                                      ToolTip.Tip="Log every message lib-chd-kit sends (shown as debug lines)." />
                            <CheckBox Content="Progress" IsChecked="{Binding Settings.General.LogProgress}" IsVisible="{Binding Settings.General.PowerUserMode}"
                                      ToolTip.Tip="Log lib-chd-kit progress reports every 10% (debug lines)." />
                            <Button Content="Copy" Command="{Binding Log.CopyCommand}" />
                            <Button Content="Save…" Command="{Binding Log.SaveCommand}" />
                            <Button Content="Clear" Command="{Binding Log.ClearCommand}" />
                            </StackPanel>
                            <Button Content="{Binding Log.ToggleText}" Command="{Binding Log.ToggleExpandedCommand}" MinWidth="84" />
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding Log.Entries}" IsVisible="{Binding Log.IsExpanded}"
                             Background="{DynamicResource LogBackground}" Padding="0,2">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="10,1" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:LogEntry">
                                <Grid ColumnDefinitions="64,34,*" Opacity="{Binding Level, Converter={x:Static v:Palette.LevelOpacity}}">
                                    <TextBlock Text="{Binding TimeText}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,Liberation Mono,monospace" FontSize="12" FontWeight="Normal" Classes="hint" />
                                    <Border Grid.Column="1" Width="4" Height="12" CornerRadius="2" HorizontalAlignment="Left"
                                            Background="{Binding Level, Converter={x:Static v:Palette.LevelBrush}}" />
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding Message}" FontWeight="Normal" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,Liberation Mono,monospace"
                                                         FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Queue drawer: every job from every tab -->
            <Border Grid.Row="3" Classes="card" Margin="12,0,12,8" Padding="0" IsVisible="{Binding Queue.IsOpen}">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,6">
                        <TextBlock Text="Queue" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Every job from every page, in the order it was added." Classes="hint"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Classes="tool" Content="Clear finished" Command="{Binding Queue.ClearFinishedCommand}" />
                            <Button Classes="tool" Content="Cancel all" Command="{Binding Queue.CancelAllCommand}" IsEnabled="{Binding Queue.IsBusy}" />
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="QueueList" MaxHeight="220" ItemsSource="{Binding Queue.Rows}" Margin="12,0,12,8" Background="Transparent">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:QueueRowViewModel">
                                    <Grid ColumnDefinitions="2*,90,1.5*,180,44,84" Margin="0,3">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Text="{Binding GroupTitle}" Classes="hint" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={x:Static v:Palette.StatusBrush}}" />
                                            <TextBlock Text="{Binding Stage}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Stage}" />
                                        </StackPanel>
                                        <ProgressBar Grid.Column="3" Value="{Binding Percent}" Minimum="0" Maximum="100" Height="6" MinWidth="0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding PercentText}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="hint" />
                                        <Button Grid.Column="5" Classes="tool" Content="Cancel" Margin="8,0,0,0" HorizontalAlignment="Right" Command="{Binding CancelCommand}"
                                                IsVisible="{Binding CanCancel}" ToolTip.Tip="Cancel this job; a queued job never starts." />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar: the queue summary, then the whole queue's progress (by item) filling the space up to Show queue.
             An empty queue reads only "Queue empty". -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="statusbar" Background="{DynamicResource HeaderBackground}" Padding="18,6">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <TextBlock Text="Queue" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="{Binding Queue.HasRows}" />
                <TextBlock Grid.Column="1" Text="{Binding Queue.StatusText}" Foreground="{DynamicResource SubtleText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ProgressBar Grid.Column="2" Value="{Binding Queue.OverallPercent}" Minimum="0" Maximum="100" Height="6" MinWidth="0" Margin="12,0,0,0"
                             VerticalAlignment="Center" IsVisible="{Binding Queue.ShowsProgress}" />
                <TextBlock Grid.Column="3" Text="{Binding Queue.OverallPercent, StringFormat={}{0:F0}%}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="10,0,24,0" MinWidth="34" TextAlignment="Right" IsVisible="{Binding Queue.ShowsProgress}" />
                <Button Grid.Column="4" Content="{Binding Queue.ToggleText}" Command="{Binding Queue.ToggleCommand}" />
            </Grid>
        </Border>
    </Grid>
</suki:SukiWindow>
