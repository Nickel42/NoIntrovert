<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:suki="https://github.com/kikipoulet/SukiUI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NoIntrovert.ViewModels"
        xmlns:core="using:NoIntrovert.Core"
        xmlns:v="using:NoIntrovert.Views"
        x:Class="NoIntrovert.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/nointrovert.ico"
        Title="NoIntrovert"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource AppBackground}"
        BackgroundStyle="Flat" BackgroundAnimationEnabled="False" BackgroundTransitionsEnabled="False"
        ShowTitlebarBackground="False" ShowBottomBorder="False"
        TitleFontSize="14" TitleFontWeight="Bold" TitleBarControlSize="12"
        DragDrop.AllowDrop="True">

    <!-- The design's title bar: the app icon and name at the left; the theme toggle, minimize, maximize and close at the right. -->
    <suki:SukiWindow.LogoContent>
        <Border Width="24" Height="24" CornerRadius="6" ClipToBounds="True">
            <Image Source="/Assets/nointrovert-64.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Border>
    </suki:SukiWindow.LogoContent>
    <suki:SukiWindow.RightWindowTitleBarControls>
        <!-- Cycles Settings › Theme: System → Dark → Light → System. Its icon (monitor, moon, sun), tooltip and
             accessible name say the current mode and the next; MainWindow.axaml.cs keeps them in step. -->
        <Button x:Name="ThemeToggle" Classes="WindowControlsButton themetoggle" Click="OnThemeToggleClick">
            <Path x:Name="ThemeToggleIcon" Width="16" Height="16" Stretch="Uniform"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
        </Button>
    </suki:SukiWindow.RightWindowTitleBarControls>

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <!-- Windows caption buttons' hover and press: a neutral tint, as Windows 11 draws them -->
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="CaptionHover" Color="#17FFFFFF" />
                <SolidColorBrush x:Key="CaptionPressed" Color="#0FFFFFFF" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="CaptionHover" Color="#10000000" />
                <SolidColorBrush x:Key="CaptionPressed" Color="#0A000000" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <!-- One rail button: icon, title, and an optional line of small text under the title -->
        <DataTemplate x:Key="RailButton" x:DataType="vm:PageViewModel">
            <Button Classes="rail" Classes.selected="{Binding IsSelected}" IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding ToolTipText}"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectPageCommand}" CommandParameter="{Binding}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Margin="0,0,0,4">
                <Grid ColumnDefinitions="Auto,*" Margin="0,10">
                    <Path Data="{Binding Icon, Converter={x:Static v:Palette.Geometry}}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Top"
                          StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Classes="railicon" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Classes="railtext">
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" FontSize="11" FontWeight="Medium"
                                   Classes="railsub" TextWrapping="Wrap" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <!-- Title bar on macOS and Linux: the rail's colour, with round 28 px window buttons; close is red on a red tint. -->
        <Style Selector=":is(Window):not(.wincaption) Button.WindowControlsButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource WindowButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>
        <Style Selector=":is(Window):not(.wincaption) Button.WindowControlsButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource PrimaryTint}" />
        </Style>
        <Style Selector=":is(Window):not(.wincaption) Button.WindowControlsButton.Close">
            <Setter Property="Background" Value="{DynamicResource DangerTint}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
        </Style>
        <Style Selector=":is(Window):not(.wincaption) Button.WindowControlsButton.Close:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerText}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector=":is(Window):not(.wincaption) Button.WindowControlsButton.themetoggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style Selector=":is(Window):not(.wincaption) Button.WindowControlsButton.themetoggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource WindowButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>

        <!-- Title bar on Windows (the window gets .wincaption, see MainWindow.axaml.cs): Windows 11's caption buttons,
             46×32 rectangles flush with the top-right corner, transparent at rest with a neutral tint on hover;
             Close turns red (#C42B1C) with a white glyph only on hover and press. The theme button matches. -->
        <Style Selector=":is(Window).wincaption Button.WindowControlsButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>
        <Style Selector=":is(Window).wincaption Button.WindowControlsButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource CaptionHover}" />
        </Style>
        <Style Selector=":is(Window).wincaption Button.WindowControlsButton:pressed">
            <Setter Property="Background" Value="{DynamicResource CaptionPressed}" />
        </Style>
        <Style Selector=":is(Window).wincaption Button.WindowControlsButton.Close:pointerover">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector=":is(Window).wincaption Button.WindowControlsButton.Close:pressed">
            <Setter Property="Background" Value="#E6C42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector=":is(Window).wincaption Button.WindowControlsButton.themetoggle">
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        </Style>
        <Style Selector=":is(Window).wincaption Button.WindowControlsButton.themetoggle:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>

        <!-- The log's counts (the status bar's chip) turn red once there's an error, so it's noticed while Activity is closed -->
        <Style Selector="TextBlock.counts">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="TextBlock.counts.error">
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
        </Style>

        <!-- The status bar's buttons: the failure badge, the error and warning chip, and Activity, all compact -->
        <Style Selector="Border.statusbar Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.statusbar Button.chip">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.statusbar Button.chip.error">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerText}" />
        </Style>
        <Style Selector="Border.statusbar Button.activity.open">
            <Setter Property="Background" Value="{DynamicResource PrimaryTint}" />
        </Style>
        <!-- The number of jobs running or waiting, on the Activity button -->
        <Style Selector="Border.countbadge">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.countbadge TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- A narrow window: the summary drops the time left and speed (its tooltip keeps them) and the "Queue" label -->
        <Style Selector="Border.statusbar TextBlock.statusshort"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="Border.statusbar.narrow TextBlock.statusshort"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="Border.statusbar.narrow TextBlock.statuslong"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="Border.statusbar.narrow TextBlock.queuelabel"><Setter Property="IsVisible" Value="False" /></Style>

        <!-- Activity's tabs: a segmented control of two radio buttons, as Settings › Theme -->
        <Style Selector="Border.segmented">
            <Setter Property="Background" Value="{DynamicResource SettingsFieldBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsFieldBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="RadioButton.segment">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SettingsFieldText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="13,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.segment:pointerover">
            <Setter Property="Background" Value="{DynamicResource SettingsSegmentHover}" />
        </Style>
        <Style Selector="RadioButton.segment:checked">
            <Setter Property="Background" Value="{DynamicResource SettingsAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- Rail icons and the line under a title are muted; on the selected page (a tint with the accent bar)
             the icon takes the text colour, and the line under the title a stronger grey that reads on the tint -->
        <Style Selector="Path.railicon">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Stroke" Value="{DynamicResource SubtleText}" />
        </Style>
        <Style Selector="Button.rail.selected Path.railicon">
            <Setter Property="Stroke" Value="{DynamicResource SukiText}" />
        </Style>
        <Style Selector="TextBlock.railsub">
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        </Style>
        <Style Selector="Button.rail.selected TextBlock.railsub">
            <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
        </Style>
        <Style Selector="Border.railpane">
            <Setter Property="Width" Value="190" />
            <Setter Property="Padding" Value="10,6,10,14" />
        </Style>
        <!-- The rail's group headers (LIBRARY, FILES, TOOLS): small, muted capitals over their pages, lined up with
             the buttons' icons. In the icon-only rail a thin divider takes the place of each header but the first. -->
        <Style Selector="TextBlock.railheader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
            <Setter Property="Margin" Value="12,12,0,6" />
        </Style>
        <Style Selector="Border.raildivider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource PrimaryTint}" />
            <Setter Property="Margin" Value="6,6,6,10" />
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- A small window (under 1100 px): the rail shows only icons, each named in its tooltip -->
        <Style Selector="Grid.shell.compact Border.railpane">
            <Setter Property="Width" Value="64" />
            <Setter Property="Padding" Value="8,14" />
        </Style>
        <Style Selector="Grid.shell.compact TextBlock.railheader">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.shell.compact StackPanel.railgroup:not(.first) Border.raildivider">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Grid.shell.compact StackPanel.railtext">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.shell.compact Path.railicon">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Grid.shell.compact Button.rail">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.statusbar TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Styles>

    <!-- Navigation rail | the page with the log and queue under it; the status bar spans the bottom. -->
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto" Classes="shell" v:Responsive.Below="compact:1100" Background="{DynamicResource AppBackground}">

        <!-- Navigation rail: the pages in labelled groups (LIBRARY: Optimize; FILES: Convert, Verify, Organize;
             TOOLS: Library tests, Power-user mode only), with Settings at the bottom below a divider. No logo: the
             title bar above already carries the app icon and name (the full illustration is in Settings › About). -->
        <Border Grid.Column="0" Classes="railpane" Background="{DynamicResource HeaderBackground}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="{DynamicResource PrimaryTint}" Margin="0,4,0,10" />
                    <ItemsControl ItemsSource="{Binding BottomPages}" ItemTemplate="{StaticResource RailButton}" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RailGroups}" x:Name="RailGroupList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RailGroupViewModel">
                                <StackPanel Classes="railgroup" Classes.first="{Binding IsFirst}" IsVisible="{Binding IsVisible}">
                                    <TextBlock Classes="railheader" Text="{Binding Header}" AutomationProperties.Name="{Binding Title}"
                                               AutomationProperties.HeadingLevel="2" />
                                    <Border Classes="raildivider" />
                                    <ItemsControl ItemsSource="{Binding Pages}" ItemTemplate="{StaticResource RailButton}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- The page, then the Activity drawer (the queue and the log) under it. The drawer's row is Auto while it's
             closed (the page takes the height) and a resizable height when open; see MainWindow.axaml.cs. -->
        <Grid Grid.Column="1" x:Name="BodyGrid" RowDefinitions="*,Auto,Auto">
            <ContentControl Grid.Row="0" Content="{Binding SelectedPage.Content}" Margin="12,6,12,0" />

            <GridSplitter Grid.Row="1" x:Name="ActivitySplitter" Height="8" Background="Transparent" ResizeDirection="Rows" IsVisible="{Binding Activity.IsOpen}" />
            <Border Grid.Row="1" Height="10" IsVisible="{Binding !Activity.IsOpen}" />

            <!-- Activity: Queue and Log tabs, their controls, and ✕ -->
            <Border Grid.Row="2" Classes="card" Margin="12,0,12,10" Padding="0" x:Name="ActivityCard" IsVisible="{Binding Activity.IsOpen}">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="10,6,6,6">
                        <Border Classes="segmented" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <RadioButton Classes="segment" x:Name="QueueTab" GroupName="ActivityTab" IsChecked="{Binding Activity.IsQueueTab}"
                                             AutomationProperties.Name="Queue">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Queue" VerticalAlignment="Center" />
                                        <Border Classes="countbadge" IsVisible="{Binding Queue.HasActive}">
                                            <TextBlock Text="{Binding Queue.ActiveCount}" />
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Classes="segment" x:Name="LogTab" GroupName="ActivityTab" IsChecked="{Binding Activity.IsLogTab}"
                                             AutomationProperties.Name="Log" Content="Log" />
                            </StackPanel>
                        </Border>
                        <!-- What the tab shows: the queue's order, or the log's counts (red with an error) -->
                        <TextBlock Grid.Column="1" Text="Every job from every page, in the order it was added." Classes="hint"
                                   VerticalAlignment="Center" Margin="12,0,8,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsVisible="{Binding Activity.IsQueueTab}" />
                        <TextBlock Grid.Column="1" Classes="hint counts" Classes.error="{Binding Log.HasErrors}" Text="{Binding Log.CountsText}"
                                   VerticalAlignment="Center" Margin="12,0,8,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsVisible="{Binding Activity.IsLogTab}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" IsVisible="{Binding Activity.IsQueueTab}">
                            <Button Classes="tool" Content="Clear finished" Command="{Binding Queue.ClearFinishedCommand}" />
                            <Button Classes="tool" Content="Cancel all" Command="{Binding Queue.CancelAllCommand}" IsEnabled="{Binding Queue.IsBusy}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" IsVisible="{Binding Activity.IsLogTab}">
                            <CheckBox Content="Show debug" IsChecked="{Binding Log.ShowDebug}" IsEnabled="{Binding !Log.ShowOnlyErrors}" />
                            <CheckBox Content="Show only errors" IsChecked="{Binding Log.ShowOnlyErrors}"
                                      ToolTip.Tip="Show only the error lines. Copy and Save… then include only those too." />
                            <CheckBox Content="lib-chd-kit messages" IsChecked="{Binding Settings.General.VerboseLog}" IsVisible="{Binding Settings.General.PowerUserMode}"
                                      ToolTip.Tip="Log every message lib-chd-kit sends (shown as debug lines)." />
                            <CheckBox Content="Progress" IsChecked="{Binding Settings.General.LogProgress}" IsVisible="{Binding Settings.General.PowerUserMode}"
                                      ToolTip.Tip="Log lib-chd-kit progress reports every 10% (debug lines)." />
                            <Button Classes="tool" Content="Copy" Command="{Binding Log.CopyCommand}" />
                            <Button Classes="tool" Content="Save…" Command="{Binding Log.SaveCommand}" />
                            <Button Classes="tool" Content="Clear" Command="{Binding Log.ClearCommand}"
                                    ToolTip.Tip="Clear the lines shown here (and what Copy and Save… include). The session's log file keeps every line: Settings › Log › Open log folder." />
                        </StackPanel>
                        <Button Grid.Column="3" x:Name="ActivityClose" Classes="tool" Content="✕" Margin="8,0,0,0" Padding="10,6"
                                Command="{Binding Activity.CloseCommand}" ToolTip.Tip="{Binding Activity.ToolTipText}"
                                AutomationProperties.Name="Close Activity" />
                    </Grid>

                    <!-- Queue: every job from every page -->
                    <ListBox Grid.Row="1" x:Name="QueueList" ItemsSource="{Binding Queue.Rows}" Margin="12,0,12,8" Background="Transparent"
                             IsVisible="{Binding Activity.IsQueueTab}" AutomationProperties.Name="Queue">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:QueueRowViewModel">
                                    <Grid ColumnDefinitions="2*,90,1.5*,180,44,84" Margin="0,3">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Text="{Binding GroupTitle}" Classes="hint" VerticalAlignment="Center" />
                                        <!-- A Grid, not a StackPanel: the stage gets only its column's width, so a long one trims
                                             instead of running over the progress bar -->
                                        <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center" Margin="0,0,10,0" ClipToBounds="True">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={x:Static v:Palette.StatusBrush}}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Stage}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Stage}" />
                                        </Grid>
                                        <ProgressBar Grid.Column="3" Value="{Binding Percent}" Minimum="0" Maximum="100" Height="6" MinWidth="0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding PercentText}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="hint" />
                                        <Button Grid.Column="5" Classes="tool" Content="Cancel" Margin="8,0,0,0" HorizontalAlignment="Right" Command="{Binding CancelCommand}"
                                                IsVisible="{Binding CanCancel}" ToolTip.Tip="Cancel this job; a queued job never starts." />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>
                    <Panel Grid.Row="1" IsVisible="{Binding Activity.IsQueueTab}">
                        <TextBlock Text="Nothing in the queue. A run's jobs show here, from every page." Classes="hint"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" IsVisible="{Binding !Queue.HasRows}" />
                    </Panel>

                    <!-- Log -->
                    <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding Log.Entries}" IsVisible="{Binding Activity.IsLogTab}" AutomationProperties.Name="Log"
                             Background="{DynamicResource LogBackground}" Padding="0,2" Margin="0,0,0,1">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="10,1" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:LogEntry">
                                <Grid ColumnDefinitions="64,34,*" Opacity="{Binding Level, Converter={x:Static v:Palette.LevelOpacity}}">
                                    <TextBlock Text="{Binding TimeText}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,Liberation Mono,monospace" FontSize="12" FontWeight="Normal" Classes="hint" />
                                    <!-- The level as a glyph (✕ ⚠ ✓ i ·), in its colour, so it doesn't rest on colour alone -->
                                    <TextBlock Grid.Column="1" Classes="levelglyph" Text="{Binding Level, Converter={x:Static v:Palette.LevelGlyph}}"
                                               Foreground="{Binding Level, Converter={x:Static v:Palette.LevelBrush}}"
                                               FontSize="12" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               AutomationProperties.Name="{Binding Level, Converter={x:Static v:Palette.LevelName}}" />
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding Message}" FontWeight="Normal" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,Liberation Mono,monospace"
                                                         FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar, the one summary of every run: the queue (what's running and waiting, the time left and speed),
             the whole queue's progress (by item) filling the space, "2 failed" (shows the page's failed rows), the log's
             errors and warnings (opens the Log tab), and Activity (Ctrl+J). An empty queue reads only "Queue empty".
             Narrower than 1100 px, the summary leaves the time left and speed to its tooltip. -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" x:Name="StatusBar" Classes="statusbar" Background="{DynamicResource HeaderBackground}" Padding="18,5,12,5"
                v:Responsive.Below="narrow:1100">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
                <TextBlock Classes="queuelabel" Text="Queue" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="{Binding Queue.HasRows}" />
                <Panel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip.Tip="{Binding Queue.StatusText}">
                    <TextBlock Classes="statuslong" Text="{Binding Queue.StatusText}" Foreground="{DynamicResource SubtleText}" MaxWidth="560" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="statusshort" Text="{Binding Queue.ShortStatusText}" Foreground="{DynamicResource SubtleText}" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                </Panel>
                <ProgressBar Grid.Column="2" Value="{Binding Queue.OverallPercent}" Minimum="0" Maximum="100" Height="6" MinWidth="40" Margin="12,0,0,0"
                             VerticalAlignment="Center" IsVisible="{Binding Queue.ShowsProgress}" />
                <TextBlock Grid.Column="3" Text="{Binding Queue.OverallPercent, StringFormat={}{0:F0}%}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="10,0,16,0" MinWidth="34" TextAlignment="Right" IsVisible="{Binding Queue.ShowsProgress}" />
                <Button Grid.Column="4" x:Name="FailedBadge" Classes="danger" Content="{Binding Queue.FailedText}" IsVisible="{Binding Queue.HasFailures}"
                        Command="{Binding ShowFailedRowsCommand}" Margin="0,0,8,0"
                        ToolTip.Tip="Show only the failed rows on this page (Escape in the filter box shows them all again)." />
                <Button Grid.Column="5" x:Name="ProblemsChip" Classes="chip" Classes.error="{Binding Log.HasErrors}" IsVisible="{Binding Log.HasProblems}"
                        Command="{Binding Activity.ShowProblemsCommand}" Margin="0,0,8,0" AutomationProperties.Name="{Binding Log.ChipText}"
                        ToolTip.Tip="Open the log (only its errors, when there are any).">
                    <TextBlock Classes="counts" Classes.error="{Binding Log.HasErrors}" Text="{Binding Log.ChipText}" />
                </Button>
                <Button Grid.Column="6" x:Name="ActivityButton" Classes="activity" Classes.open="{Binding Activity.IsOpen}" Command="{Binding Activity.ToggleCommand}"
                        ToolTip.Tip="{Binding Activity.ToolTipText}" AutomationProperties.Name="Activity">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="Activity" VerticalAlignment="Center" />
                        <Border Classes="countbadge" IsVisible="{Binding Queue.HasActive}">
                            <TextBlock Text="{Binding Queue.ActiveCount}" />
                        </Border>
                        <!-- ˄ while closed (it opens upwards), ˅ while open -->
                        <Path Width="10" Height="6" Stretch="Uniform" VerticalAlignment="Center" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                              Stroke="{Binding $parent[Button].Foreground}"
                              Data="{Binding Activity.IsOpen, Converter={x:Static v:MainWindow.Chevron}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</suki:SukiWindow>
