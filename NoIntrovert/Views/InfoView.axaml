<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoIntrovert.ViewModels"
             x:Class="NoIntrovert.Views.InfoView"
             x:DataType="vm:InfoViewModel">
    <Grid RowDefinitions="Auto,*" Margin="0,10,0,0" RowSpacing="12">

        <Border Classes="card" Padding="12,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="hint" Text="Open a CHD or drop one anywhere on this tab." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <CheckBox Content="Count hunks by codec (slower)" IsChecked="{Binding IncludeHunkStats}" IsEnabled="{Binding IsIdle}" />
                    <Button Classes="tool" Content="Reload" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsIdle}" />
                    <Button Classes="tool" Content="Copy all" Command="{Binding CopyAllCommand}" IsEnabled="{Binding HasInfo}" />
                    <Button Classes="primary" Content="Open CHD…" Command="{Binding OpenCommand}" IsEnabled="{Binding IsIdle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="420,*" ColumnSpacing="12">

            <!-- Header fields -->
            <Border Classes="card" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="HEADER" Classes="section" Margin="14,12,14,6" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Properties}" Background="Transparent" Margin="6,0,6,6">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:InfoRow">
                                <Grid ColumnDefinitions="110,*">
                                    <TextBlock Text="{Binding Name}" Classes="hint" VerticalAlignment="Top" />
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="2*,*" RowSpacing="12">

                <!-- Metadata -->
                <Border Classes="card" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Grid ColumnDefinitions="*,Auto" Margin="14,10,10,4">
                            <TextBlock Text="METADATA" Classes="section" Margin="0" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="tool" Content="Save selected…" Command="{Binding SaveMetadataCommand}" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="70,40,90,80,*" Margin="24,0,24,2">
                            <TextBlock Text="TAG" Classes="colhead" />
                            <TextBlock Grid.Column="1" Text="#" Classes="colhead" />
                            <TextBlock Grid.Column="2" Text="FLAGS" Classes="colhead" />
                            <TextBlock Grid.Column="3" Text="LENGTH" Classes="colhead" />
                            <TextBlock Grid.Column="4" Text="VALUE" Classes="colhead" />
                        </Grid>
                        <ListBox Grid.Row="2" ItemsSource="{Binding Metadata}" SelectedItem="{Binding SelectedMetadata}"
                                 Background="Transparent" Margin="10,0,10,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetadataRow">
                                    <Grid ColumnDefinitions="70,40,90,80,*">
                                        <TextBlock Text="{Binding Tag}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,Liberation Mono,monospace" />
                                        <TextBlock Grid.Column="1" Text="{Binding Index}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Flags}" Classes="hint" />
                                        <TextBlock Grid.Column="3" Text="{Binding LengthText}" Classes="hint" />
                                        <SelectableTextBlock Grid.Column="4" Text="{Binding Text}" TextWrapping="Wrap"
                                                             FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,Liberation Mono,monospace" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Hunk stats -->
                <Border Grid.Row="1" Classes="card" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="HUNKS BY CODEC" Classes="section" Margin="14,12,14,6" />
                        <TextBlock Grid.Row="1" Classes="hint" Margin="14,0" IsVisible="{Binding !IncludeHunkStats}"
                                   Text="Tick “Count hunks by codec” to see how many hunks each codec compressed." />
                        <ListBox Grid.Row="1" ItemsSource="{Binding HunkStats}" Background="Transparent" Margin="6,0,6,6"
                                 IsVisible="{Binding IncludeHunkStats}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:HunkRow">
                                    <Grid ColumnDefinitions="*,120,80">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Hunks, StringFormat='{}{0:N0}'}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding Share}" Classes="hint" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
