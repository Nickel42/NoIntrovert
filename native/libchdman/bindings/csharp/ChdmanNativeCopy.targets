<Project>
  <!--
    For projects that reference LibChdman.csproj directly (rather than the
    NuGet package): copy the locally built native library next to the
    executable. Pass -p:ChdmanLibDir=<dir containing chdman.dll or
    libchdman.dylib>; with the Visual Studio generator that is
    <build dir>/Release.
  -->
  <PropertyGroup>
    <ChdmanLibDir Condition="'$(ChdmanLibDir)' == ''">$(MSBuildThisFileDirectory)../../build</ChdmanLibDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(ChdmanLibDir)/chdman.dll" Condition="Exists('$(ChdmanLibDir)/chdman.dll')" CopyToOutputDirectory="PreserveNewest" Link="chdman.dll" Visible="false" />
    <None Include="$(ChdmanLibDir)/libchdman.dylib" Condition="Exists('$(ChdmanLibDir)/libchdman.dylib')" CopyToOutputDirectory="PreserveNewest" Link="libchdman.dylib" Visible="false" />
  </ItemGroup>
</Project>
