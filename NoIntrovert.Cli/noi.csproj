<Project Sdk="Microsoft.NET.Sdk">
  <!--
    noi: NoIntrovert's command line (docs/requirements/cli.md). A console program of its own, since the app is a
    GUI-subsystem executable on Windows and can't write to the console that started it. It runs on
    NoIntrovert.Core, the same code as the app, and ships beside it in every download.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>noi</AssemblyName>
    <RootNamespace>NoIntrovert.Cli</RootNamespace>
    <AssemblyTitle>noi</AssemblyTitle>
    <Product>NoIntrovert command line</Product>
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">../NoIntrovert/Assets/nointrovert.ico</ApplicationIcon>
    <!-- Release builds get the version from the git tag (release.yml passes -p:Version). -->
    <Version>0.5.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationManifest>noi.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NoIntrovert.Core/NoIntrovert.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoIntrovert.Tests" />
  </ItemGroup>

  <!-- chdkit, 7-Zip's engine and lib-wii-gamecube-kit beside the executable, as for the app. -->
  <Import Project="../build/NativeLibraries.targets" />
</Project>
